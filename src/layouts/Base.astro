---
import "../styles/global.css";
import LensLogo from "../components/LensLogo.astro";
import { HIDE_SUPPLIES, getFlag } from "../lib/settings";

interface Props {
  title: string;
  description?: string;
  /** Drop the header entirely. The front page is a door, not a place to
   *  navigate from — every nav item leads somewhere behind that door, so
   *  offering them before it is opened is offering two ways past the same
   *  point and makes the one button stop looking like the way in. */
  bare?: boolean;
}

const { title, description = "Search and compare all 232 KHDA-registered private schools in Dubai: curriculum, fees, inspection rating, and location.", bare = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * The separators are real elements rather than ::after on each link, because
 * every nav item fills on hover — a pseudo-element would sit inside that fill
 * and light up with the item before it, making one link look two wide.
 */
const NAV = [
  { href: "FAQ", label: "FAQ" },
  { href: "/parents/pick-of-the-week", label: "Today's-spotlight" },
  { href: "SUPPLIES", label: "School Supplies" },
  { href: "/parents/travel-time", label: "Travel Time" },
  { href: "SCHOOLNEWS", label: "Schools News" },
  { href: "COMMUNICATE", label: "Communicate" },
  { href: "/advertise/communicate", label: "Advertise" },
  { href: "/overview#chatbox", label: "Chatbot" },
];

/**
 * Which nav item the page belongs to.
 *
 * Compared on the path alone: the Chatbot item points at /overview#chatbox,
 * and a fragment is not part of a page's identity. A school page under
 * /schools/... matches nothing in the bar, which is correct — no nav item
 * claims it. Nor does "/", which is the splash and has no section of its own.
 */
const here = (Astro.url.pathname.replace(/\/+$/, "") || "/").toLowerCase();

/* One database read per render, and it decides whether a menu item exists
   at all rather than hiding it with CSS — a hidden link is still a link in
   the tab order and still something a crawler follows. */
const hideSupplies = await getFlag(HIDE_SUPPLIES);
/* Advertise is a school-facing offer, so it comes out of the parents'
   section. Scoped to /parents rather than to the one page: a parent who
   moves from the overview to the communicate page has not become an
   advertiser on the way, and a nav item that reappears one click later
   reads as a bug. */
const hideAdvertise = here.startsWith("/parents");

/* Travel time is a parent's question — how long the school run takes from
   home. A school has no home to measure from, so it comes out of the schools'
   section for the same reason Advertise comes out of the parents'. */
const hideTravel = here.startsWith("/schools");

const nav = NAV.filter(
  (n) =>
    !(hideSupplies && n.href === "SUPPLIES") &&
    !(hideAdvertise && n.href.startsWith("/advertise")) &&
    !(hideTravel && n.href === "/parents/travel-time")
);

/**
 * Communicate follows the section you are already in.
 *
 * There are two of these pages now, one per audience, and the nav is shared by
 * every page — so the link has to be resolved per request rather than written
 * once. A school reading its own overview should not be sent to the parents'
 * form to say which one it is; it has already said.
 *
 * Anything outside either section falls to the parents' page: that is who most
 * visitors are, and the tabs on it lead to the other one in a click.
 */
/* Two FAQs now, one per audience, resolved the same way Communicate is —
   which is the routing that had to be fixed once the page stopped being one
   page. */
const faqHref = here.startsWith("/schools") ? "/schools/faq" : "/parents/faq";
const suppliesHref = here.startsWith("/schools") ? "/schools/supplies" : "/parents/supplies";
const newsHref = here.startsWith("/schools") ? "/schools/schoolnews" : "/parents/schoolnews";


const communicateHref = here.startsWith("/schools")
  ? "/schools/communicate"
  : "/parents/communicate";

/* Every nav item that exists once per audience. The sentinel in NAV is a
   placeholder, not a URL — it is resolved here, per request, because the
   nav is shared by both sections and the right target depends on which
   one you are standing in. A lookup rather than a chain of ternaries:
   there are four now, and each one added made the chain harder to read
   than the thing it was expressing. */
const SECTIONED: Record<string, string> = {
  COMMUNICATE: communicateHref,
  FAQ: faqHref,
  SUPPLIES: suppliesHref,
  SCHOOLNEWS: newsHref,
};
const isHere = (href: string) => {
  const base = (href.split("#")[0].replace(/\/+$/, "") || "/").toLowerCase();
  if (base === "/") return false;           // the splash has no nav item
  return here === base || here.startsWith(base + "/");
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Quicksand:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class={bare ? "is-bare" : undefined}>
{!bare && (
    <header class="site-head">
      <div class="wrap">
        <div class="brandwrap">
          <a class="brand" href="/">
            <LensLogo size={28} layout="centred" class="brand-mark" />
            <span class="brand-word">Dubai<span>Schools</span></span>
          </a>
          <span class="brandsep" aria-hidden="true">:</span>
          <a class="partof" href="https://www.can-du-ai.com">Part of can-du-ai.com<span class="nav-mark" aria-hidden="true">▲</span></a>
        </div>
        <nav>
          {nav.map((raw, i) => {
            const item = raw.href in SECTIONED ? { ...raw, href: SECTIONED[raw.href] } : raw;
            const current = isHere(item.href);
            const last = i === nav.length - 1;
            /* The mark points down at the page you are on. The chatbot has no
               page of its own — it sits on the overview — so its mark points
               down only while you are there to see it. */
            const down = item.href.includes("#") ? here === "/" : current;
            return (
              <>
                <a
                  href={item.href}
                  class={current ? "is-here" : undefined}
                  aria-current={current ? "page" : undefined}
                >
                  {item.label}
                </a>
                {/* Nothing follows the last item, so it carries no mark.
                    Dropping the last one shifts nothing: everything that
                    could move is to its left. */}
                {!last && (
                  <span class={down ? "nav-sep is-down" : "nav-sep"} aria-hidden="true">
                    {down ? "\u25bc" : "\u25ba"}
                  </span>
                )}
              </>
            );
          })}
        </nav>
      </div>
    </header>
    )}

    <main>
      <slot />
    </main>
  </body>
</html>
