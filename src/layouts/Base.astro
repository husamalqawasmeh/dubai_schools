---
import "../styles/global.css";
import LensLogo from "../components/LensLogo.astro";
import { HIDE_SUPPLIES, getFlag } from "../lib/settings";

interface Props {
  title: string;
  description?: string;
  /** Drop the header entirely. The front page is a door, not a place to
   *  navigate from — every nav item leads somewhere behind that door, so
   *  offering them before it is opened is offering two ways past the same
   *  point and makes the one button stop looking like the way in. */
  bare?: boolean;

  /** Keep the brand bar, drop the nav. For a page reached from the front
   *  page rather than from inside a section: the bar still gets you home,
   *  but a row of section links on a page that belongs to no section was
   *  offering eight ways out of somewhere you had just chosen to be. */
  nonav?: boolean;
}

const { title, description = "Search and compare all 232 KHDA-registered private schools in Dubai: curriculum, fees, inspection rating, and location.", bare = false, nonav = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * The separators are real elements rather than ::after on each link, because
 * every nav item fills on hover — a pseudo-element would sit inside that fill
 * and light up with the item before it, making one link look two wide.
 */
const NAV = [
  { href: "OVERVIEW", label: "Overview" },
  { href: "FAQ", label: "FAQ" },
  { href: "/parents/pick-of-the-week", label: "School Pick-of-the-week" },
  { href: "SUPPLIES", label: "School Supplies" },
  { href: "/parents/travel-time", label: "Travel Time" },
  { href: "SCHOOLNEWS", label: "Schools News" },
  { href: "COMMUNICATE", label: "Communicate" },
  { href: "/schools/advertise", label: "Advertise" },
  { href: "ADMINFN", label: "Admin Functions" },
  { href: "CHATBOT", label: "Chatbot" },
];

/**
 * Which nav item the page belongs to.
 *
 * Compared on the path alone: the Chatbot item points at an overview plus
 * and a fragment is not part of a page's identity. A school page under
 * /schools/... matches nothing in the bar, which is correct — no nav item
 * claims it. Nor does "/", which is the splash and has no section of its own.
 */
const here = (Astro.url.pathname.replace(/\/+$/, "") || "/").toLowerCase();

/**
 * Whether this page belongs to the schools' section — which is not the same
 * as living under /schools.
 *
 * That prefix does two jobs. It is the schools' section (/schools/faq,
 * /schools/communicate…) and it is the public directory: /schools lists all
 * 232, and /schools/<slug> is one school's page. Those are the pages parents
 * spend their time on, reached by "Browse all 232" from the parents'
 * overview — so testing the prefix alone silently moved a parent into the
 * schools' nav mid-visit, swapping Travel Time and the weekly pick for
 * Advertise and pointing Communicate at the school-admin form.
 *
 * The section is a fixed, small set of names; everything else under /schools
 * is directory, and directory falls to the parents' nav like anything else
 * outside a section.
 */
const SCHOOL_SECTION = new Set([
  "overview", "faq", "communicate", "school-supplies", "school-news", "advertise",
]);
const inSchools = (() => {
  const seg = here.split("/");   // "/schools/faq" -> ["", "schools", "faq"]
  return seg[1] === "schools" && SCHOOL_SECTION.has(seg[2] ?? "");
})();

/* One database read per render, and it decides whether a menu item exists
   at all rather than hiding it with CSS — a hidden link is still a link in
   the tab order and still something a crawler follows. */
const hideSupplies = await getFlag(HIDE_SUPPLIES);
/* Advertise is a school-facing offer, so it appears only inside the schools'
   section — not merely outside the parents' one. Hiding it by /parents left
   it on every neutral page, including the directory and each school's own
   page, which are exactly where a parent spends the visit: the one nav item
   pointing into the schools' section was the one a parent was most likely
   to be offered. */
const hideAdvertise = !inSchools;

/* Travel time is a parent's question — how long the school run takes from
   home. A school has no home to measure from, so it comes out of the schools'
   section for the same reason Advertise comes out of the parents'. */
const hideTravel = inSchools;

/* Same for the weekly pick. It is a school chosen for parents to look at;
   showing a school a shortlist it might not be on is a different proposition
   entirely, and not one this page is making. */
const hidePick = inSchools;

/* The console keeps only the chatbot.

   Every other item leads out into the public site, and an admin working
   through the queue is not browsing it — the row was seven ways to lose the
   page you were on. The chatbot stays because it is the one thing there
   worth reaching mid-task, and the brand mark still goes home. */
const isConsole = here.startsWith("/admin");

const nav = NAV.filter(
  (n) =>
    !(hideSupplies && n.href === "SUPPLIES") &&
    !(hideAdvertise && n.href === "/schools/advertise") &&
    !(hideTravel && n.href === "/parents/travel-time") &&
    !(hidePick && n.href === "/parents/pick-of-the-week") &&
    !(isConsole && n.href !== "CHATBOT" && n.href !== "ADMINFN" && n.href !== "OVERVIEW") &&
    /* And Admin Functions exists only there — it is the console's own menu,
       and a link to it on a public page is a locked door with a sign on it. */
    !(!isConsole && n.href === "ADMINFN")
);

/**
 * Communicate follows the section you are already in.
 *
 * There are two of these pages now, one per audience, and the nav is shared by
 * every page — so the link has to be resolved per request rather than written
 * once. A school reading its own overview should not be sent to the parents'
 * form to say which one it is; it has already said.
 *
 * Anything outside either section falls to the parents' page: that is who most
 * visitors are, and the tabs on it lead to the other one in a click.
 */
/* Two FAQs now, one per audience, resolved the same way Communicate is —
   which is the routing that had to be fixed once the page stopped being one
   page. */
const faqHref = inSchools ? "/schools/faq" : "/parents/faq";
const suppliesHref = inSchools ? "/schools/school-supplies" : "/parents/school-supplies";
const newsHref = inSchools ? "/schools/school-news" : "/parents/school-news";

/* Each section opens on its own overview, and it leads the bar because it is
   the page the rest of the section hangs off — the one item that answers
   "where am I" rather than "where else could I go". The console gets it for
   the same reason, and is the one place it had to be spared by the filter
   above rather than simply appearing. */
const overviewHref = isConsole
  ? "/admin/overview"
  : inSchools
    ? "/schools/overview"
    : "/parents/overview";

/* The chatbot lives on an overview — the same one, so it follows you into
   whichever section you are in rather than sending a parent into the schools'
   copy to ask a question. Derived rather than repeated: the two were the same
   three-way choice written twice, and only one of them would have been
   updated when a fourth section arrives. */
const chatbotHref = `${overviewHref}#chatbox`;


const communicateHref = inSchools
  ? "/schools/communicate"
  : "/parents/communicate";

/* Every nav item that exists once per audience. The sentinel in NAV is a
   placeholder, not a URL — it is resolved here, per request, because the
   nav is shared by both sections and the right target depends on which
   one you are standing in. A lookup rather than a chain of ternaries:
   there are four now, and each one added made the chain harder to read
   than the thing it was expressing. */
const SECTIONED: Record<string, string> = {
  OVERVIEW: overviewHref,
  COMMUNICATE: communicateHref,
  FAQ: faqHref,
  SUPPLIES: suppliesHref,
  SCHOOLNEWS: newsHref,
  CHATBOT: chatbotHref,
  ADMINFN: "/admin/admin",
};
const isHere = (href: string) => {
  const base = (href.split("#")[0].replace(/\/+$/, "") || "/").toLowerCase();
  if (base === "/") return false;           // the splash has no nav item
  return here === base || here.startsWith(base + "/");
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Quicksand:wght@400;500;600;700&display=swap"
    />
  </head>
  <body class={bare ? "is-bare" : undefined}>
{!bare && (
    <header class="site-head">
      <div class="wrap">
        <div class="brandwrap">
          <a class="brand" href="/">
            <LensLogo size={28} layout="centred" class="brand-mark" />
            <span class="brand-word">Dubai<span>Schools</span></span>
          </a>
          <span class="brandsep" aria-hidden="true">:</span>
          <a class="partof" href="https://www.can-du-ai.com">Part of can-du-ai.com<span class="nav-mark" aria-hidden="true">▲</span></a>
        </div>
        {!nonav && (
        <nav>
          {nav.map((raw, i) => {
            const item = raw.href in SECTIONED ? { ...raw, href: SECTIONED[raw.href] } : raw;
            const current = isHere(item.href);
            const last = i === nav.length - 1;
            /* The mark points down at the page you are on. The chatbot has no
               page of its own — it sits on the overview — so its mark points
               down only while you are there to see it. */
            const down = item.href.includes("#") ? here === "/" : current;
            return (
              <>
                <a
                  href={item.href}
                  class={current ? "is-here" : undefined}
                  aria-current={current ? "page" : undefined}
                >
                  {item.label}
                </a>
                {/* Nothing follows the last item, so it carries no mark.
                    Dropping the last one shifts nothing: everything that
                    could move is to its left. */}
                {!last && (
                  <span class={down ? "nav-sep is-down" : "nav-sep"} aria-hidden="true">
                    {down ? "\u25bc" : "\u25ba"}
                  </span>
                )}
              </>
            );
          })}
        </nav>
        )}
      </div>
    </header>
    )}

    <main>
      <slot />
    </main>
  </body>
</html>
