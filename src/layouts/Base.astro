---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Search and compare all 232 KHDA-registered private schools in Dubai: curriculum, fees, inspection rating, and location." } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

/**
 * The separators are real elements rather than ::after on each link, because
 * every nav item fills on hover — a pseudo-element would sit inside that fill
 * and light up with the item before it, making one link look two wide.
 */
const NAV = [
  { href: "/faq", label: "FAQ" },
  { href: "/pick-of-the-week", label: "Today's-spotlight" },
  { href: "/supplies", label: "School Supplies" },
  { href: "/travel-time", label: "Travel Time" },
  { href: "/news", label: "Schools News" },
  { href: "/contribute", label: "Contribute" },
  { href: "/advertise", label: "Advertise" },
  { href: "/#chatbox", label: "Chatbot" },
];

/**
 * Which nav item the page belongs to.
 *
 * Compared on the path alone: the Chatbot item points at /#chatbox, and a
 * fragment is not part of a page's identity. A school page under /schools/...
 * matches nothing in the bar, which is correct — no nav item claims it.
 */
const here = (Astro.url.pathname.replace(/\/+$/, "") || "/").toLowerCase();
const isHere = (href: string) => {
  const base = (href.split("#")[0].replace(/\/+$/, "") || "/").toLowerCase();
  if (base === "/") return false;           // the overview has no nav item
  return here === base || here.startsWith(base + "/");
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Quicksand:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <header class="site-head">
      <div class="wrap">
        <div class="brandwrap">
          <a class="brand" href="/">Dubai <span>Schools</span></a>
          <span class="brandsep" aria-hidden="true">:</span>
          <a class="partof" href="https://www.can-du-ai.com">Part of can-du-ai.com<span class="nav-mark" aria-hidden="true">▲</span></a>
        </div>
        <nav>
          {NAV.map((item) => {
            const current = isHere(item.href);
            /* The mark points down at the page you are on. The chatbot has no
               page of its own — it sits on the overview — so its mark points
               down only while you are there to see it. */
            const down = item.href.includes("#") ? here === "/" : current;
            return (
              <>
                <a
                  href={item.href}
                  class={current ? "is-here" : undefined}
                  aria-current={current ? "page" : undefined}
                >
                  {item.label}
                </a>
                <span class={down ? "nav-sep is-down" : "nav-sep"} aria-hidden="true">
                  {down ? "\u25bc" : "\u25ba"}
                </span>
              </>
            );
          })}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>
  </body>
</html>
