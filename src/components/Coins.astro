---
/**
 * Fee band as a stack of dirham coins: one coin for the cheapest band, four
 * for the dearest. Height carries the meaning, so empty slots are not drawn —
 * a taller stack is more money, the way a pile of coins actually reads.
 *
 * Deliberately not a second colour scale: the teal ramp already means "KHDA
 * rating", and two coloured ordinal scales on one card would compete.
 *
 * The dirham mark is drawn as paths rather than set as a character. The UAE's
 * dirham symbol is too new for reliable font coverage, and a missing glyph
 * would render as a blank box on the one element that has to say "money".
 */
interface Props {
  n: number;               // 1–4
  size?: "sm" | "lg";
  label?: string;
}
const { n, size = "sm", label } = Astro.props;
const big = size === "lg";

const count = Math.max(0, Math.min(4, n));

// Geometry. The stack grows upward from a fixed baseline so stacks of
// different heights sit on a common floor.
// Wider and flatter than before, with a step larger than the coin's own
// thickness so a rim of the coin beneath always shows. Stacked cylinders that
// touch read as one lump; a visible ledge between them is what makes the
// count legible at a glance.
const rx = big ? 15 : 7;
const ry = big ? 5 : 2.5;
const thick = big ? 4.6 : 2;
const step = big ? 7.4 : 3.3;
const cx = big ? 24 : 9;
const baseY = big ? 41 : 15.4;
const w = big ? 48 : 18;
const h = big ? 52 : 20;

// Bottom coin first, so later (higher) coins paint over the ones beneath.
const coins = Array.from({ length: count }, (_, i) => baseY - i * step);
const topY = coins.length ? coins[coins.length - 1] : baseY;
---

<svg
  class={big ? "coins coins-lg" : "coins"}
  viewBox={`0 0 ${w} ${h}`}
  width={w}
  height={h}
  role="img"
  aria-label={label ? `${label} — ${count} of 4` : `${count} of 4`}
>
  {coins.map((y) => (
    <g>
      {/* cylinder side */}
      <path
        class="coin-edge"
        d={`M ${cx - rx} ${y} v ${thick} a ${rx} ${ry} 0 0 0 ${rx * 2} 0 v ${-thick} z`}
      />
      {/* the ledge where this coin meets the one below */}
      <path
        class="coin-lip"
        d={`M ${cx - rx} ${y + thick} a ${rx} ${ry} 0 0 0 ${rx * 2} 0`}
      />
      {/* top face */}
      <ellipse class="coin-face" cx={cx} cy={y} rx={rx} ry={ry} />
    </g>
  ))}

  {big && count > 0 && (
    /* Dirham mark on the top face. Squashed to match the ellipse, which is
       how a face actually sits when a coin is seen at this angle. */
    <g class="coin-mark" transform={`translate(${cx} ${topY}) scale(1 0.4)`}>
      <path d="M -3.4 -6.6 L -3.4 6.6" />
      <path d="M -3.4 -6.6 C 4.6 -6.6, 6.2 -3.4, 6.2 0 C 6.2 3.4, 4.6 6.6, -3.4 6.6" />
      <path d="M -7.4 -2.4 L 7.6 -2.4" />
      <path d="M -7.4 2.4 L 7.6 2.4" />
    </g>
  )}
</svg>
