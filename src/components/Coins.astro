---
/**
 * Fee band as a stack of coins: one coin for the cheapest band, four for the
 * dearest. Height carries the meaning, which is why empty slots are not drawn
 * — a taller stack is more money, the way a pile of coins actually reads.
 *
 * Deliberately not a second colour scale: the teal ramp already means "KHDA
 * rating", and two coloured ordinal scales on one card would compete.
 */
interface Props {
  n: number;          // 1–4
  label?: string;
}
const { n, label } = Astro.props;

// Stacked from the baseline upward.
const ys = [17.4, 13.3, 9.2, 5.1];
const coins = ys.slice(0, Math.max(0, Math.min(4, n)));
---

<svg
  class="coins"
  viewBox="0 0 17 20"
  width="17"
  height="20"
  role="img"
  aria-label={label ?? `${n} of 4`}
>
  {coins.map((y) => (
    <ellipse cx="8.5" cy={y} rx="6.6" ry="2.5" />
  ))}
</svg>
