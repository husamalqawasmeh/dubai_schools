---
// The generated markup is imported rather than pasted, so the static file in
// public/ and the animated one here are the same shapes by construction. Edit
// scripts/build-logo.mjs and re-run it; never edit either output.
import lens from "./generated-lens.html?raw";
import lensCentred from "./generated-lens-centred.html?raw";

interface Props {
  /** Rendered size in px. The art is a 220-unit square. */
  size?: number;
  /** Bubbles drift when true. Off by default — a logo in a header should sit
   *  still; motion is for the one place that is showing it off. */
  animated?: boolean;
  /** "packed" is the solver's arrangement; "centred" puts student, school and
   *  teacher in the middle with the other eight evenly around them. */
  layout?: "packed" | "centred";
  class?: string;
}

const { size = 200, animated = false, layout = "packed", class: cls = "" } = Astro.props;
const art = layout === "centred" ? lensCentred : lens;
---

<svg
  class={`lenslogo ${animated ? "is-animated" : ""} ${cls}`}
  viewBox="0 0 220 220"
  width={size}
  height={size}
  role="img"
  aria-label="Dubai Schools"
  set:html={art}
/>
