---
/**
 * A checkbox dropdown. Built on <details> so it opens and closes without
 * JavaScript, and so the whole list is still readable if the script never runs.
 *
 * Options may be flat, or grouped one level deep. A group with a single member
 * renders flat — a disclosure triangle over one child is noise, and the child's
 * own name is more honest than the group's ("Al Nahda Second", not "Al Nahda",
 * when that is the only one KHDA lists).
 *
 * Counts are over the whole directory rather than the currently filtered set,
 * so a number never shifts under the pointer while working down the same list.
 */
export interface Option {
  value: string;
  label: string;
  count: number;
}
export interface Group {
  label: string;
  count: number;
  children: Option[];
}
interface Props {
  id: string;          // also the query-string key
  label: string;
  /** Drawn before the label. Marks what the filter is about at a glance, the
   *  way the coins already mark the fee band. */
  icon?: "flag" | "stamp" | "coins" | "map";
  options?: Option[];
  groups?: Group[];
  selected: string[];
  allLabel: string;
  scroll?: boolean;
}
const { id, label, icon, options = [], groups, selected, allLabel, scroll = false } = Astro.props;

const flat: Option[] = groups ? groups.flatMap((g) => g.children) : options;

const summary =
  selected.length === 0
    ? allLabel
    : selected.length === 1
      ? (flat.find((o) => o.value === selected[0])?.label ?? selected[0])
      : `${selected.length} selected`;

const anySelected = (g: Group) => g.children.some((c) => selected.includes(c.value));
const allSelected = (g: Group) => g.children.every((c) => selected.includes(c.value));
---

<div class="field">
  <label id={`${id}-label`}>
    {icon === "flag" && (
      <span class="field-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 21V4" />
          <path d="M5 4.5h11.5l-2.2 3.6 2.2 3.6H5z" />
        </svg>
      </span>
    )}
    {icon === "coins" && (
      <span class="field-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <ellipse cx="12" cy="7" rx="7" ry="3" />
          <path d="M5 7v4.5c0 1.7 3.1 3 7 3s7-1.3 7-3V7" />
          <path d="M5 12.5V17c0 1.7 3.1 3 7 3s7-1.3 7-3v-4.5" />
        </svg>
      </span>
    )}
    {icon === "map" && (
      <span class="field-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 3 3 5.4v15.1L9 18l6 2.5 6-2.4V3l-6 2.4z" />
          <path d="M9 3v15" />
          <path d="M15 5.4v15.1" />
        </svg>
      </span>
    )}
    {icon === "stamp" && (
      <span class="field-ico" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="8.6" r="4.4" />
          <path d="M9.6 12.6 9 16h6l-.6-3.4" />
          <path d="M5.5 19.5h13" />
        </svg>
      </span>
    )}
    {label}
  </label>
  <details class="multi" data-key={id}>
    <summary aria-label={`${label}, choose one or more`}>
      <span class="multi-summary">{summary}</span>
      <svg class="multi-caret" viewBox="0 0 12 12" aria-hidden="true">
        <path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </summary>

    <div class={scroll ? "multi-panel multi-scroll" : "multi-panel"} role="group" aria-labelledby={`${id}-label`}>
      <button type="button" class="multi-clear">Clear the filter selections</button>
      {groups
        ? groups.map((g) =>
            g.children.length === 1 ? (
              <label class="multi-opt">
                <input type="checkbox" value={g.children[0].value} checked={selected.includes(g.children[0].value)} />
                <span class="multi-name">{g.children[0].label}</span>
                <span class="multi-n">({g.children[0].count})</span>
              </label>
            ) : (
              <div class="multi-group">
                <div class="multi-opt is-parent">
                  <input
                    type="checkbox"
                    class="grp"
                    checked={allSelected(g)}
                    data-some={anySelected(g) && !allSelected(g) ? "1" : undefined}
                  />
                  <button type="button" class="grp-name" aria-expanded={anySelected(g) ? "true" : "false"}>
                    <span>{g.label}</span>
                    <svg class="tri" viewBox="0 0 10 10" aria-hidden="true">
                      <path d="M3.5 2 6.5 5l-3 3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  </button>
                  <span class="multi-n">({g.count})</span>
                </div>
                <div class="multi-kids" hidden={!anySelected(g)}>
                  {g.children.map((o) => (
                    <label class="multi-opt is-kid">
                      <input type="checkbox" value={o.value} checked={selected.includes(o.value)} />
                      <span class="multi-name">{o.label}</span>
                      <span class="multi-n">({o.count})</span>
                    </label>
                  ))}
                </div>
              </div>
            )
          )
        : options.map((o) => (
            <label class="multi-opt">
              <input type="checkbox" value={o.value} checked={selected.includes(o.value)} />
              <span class="multi-name">{o.label}</span>
              <span class="multi-n">({o.count})</span>
            </label>
          ))}
    </div>
  </details>
</div>
