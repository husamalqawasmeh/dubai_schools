---
import { BANDS } from "../lib/providers";
import { env } from "cloudflare:workers";

/**
 * The supplier directory: the section bar and the five bands.
 *
 * A component because three pages show it — /suppliers, and a copy in each
 * section — and the only difference between them is whether the registration
 * form follows. Three copies of this markup would have drifted the first time
 * one of them was edited and the others forgotten.
 *
 * It reads the database itself rather than taking rows as a prop. Every page
 * that shows it wants the same query, and a prop would have let one of them
 * pass something else — including, one day, unapproved rows.
 */
interface Props {
  /** Draw the section bar. Off where the page has put those options into the
   *  header instead — two bars of navigation for one page is one too many. */
  showNav?: boolean;
  /** Let a row open. Off where the list is there for reference rather than for
   *  reading — a row that cannot be opened should not look as though it can. */
  expandable?: boolean;
  /** Where the Chatbot item in the bar should point. The chatbot lives on an
   *  overview, and which overview depends on who is reading. */
  chatHref?: string;
}
const { chatHref = "/parents/overview#chatbox", showNav = true, expandable = true } = Astro.props;

const DB = (env as unknown as { DB: D1Database }).DB;

const { results } = await DB.prepare(
  `SELECT id, name, category, summary, detail, areas, phone, email, website
     FROM providers
    WHERE status = 'approved'
    ORDER BY category, name COLLATE NOCASE`
).all<any>();

const live = results ?? [];
const byBand = BANDS.map((b) => ({
  ...b,
  items: live.filter((p) => (b.of as readonly string[]).includes(p.category)),
}));
---
    {/* Boxes, and nothing between them. The separators went with the chatbot:
        an arrow between two boxes points at a thing that already has an edge
        of its own, and once the last item was removed the row ended in an
        arrow leading nowhere. */}
    {showNav && (
    <nav class="supnav" aria-label="Sections of this page">
      {byBand.map((b) => (
        <a href={`#cat-${b.id}`}>{b.label}<span class="supnav-n">{b.items.length}</span></a>
      ))}
    </nav>
    )}

        {byBand.filter((c) => c.items.length > 0).map((c) => (
          <section class="prov-group" id={`cat-${c.id}`}>
              <h2 class="prov-bandname">{c.label}</h2>
            <div class="prov-list">
              {/* One line. Where it opens, the closed state is the whole line and
                  the detail waits behind it; details/summary rather than a script,
                  so it works with JavaScript off. Where it does not open, the same
                  line is drawn flat. */}
              {c.items.map((p) => (
                expandable ? (
                <details class="prov">
                  <summary>
                    <span class="prov-name">{p.name}</span>
                    <span class="prov-sum">{p.summary}</span>
                    {p.areas && <span class="prov-areas">{p.areas}</span>}
                  </summary>
                  <div class="prov-body">
                    {p.detail && <p class="prov-detail">{p.detail}</p>}
                    <p class="prov-contact">
                      {p.phone && <a href={`tel:${p.phone.replace(/[^+\d]/g, "")}`}>{p.phone}</a>}
                      {p.phone && (p.email || p.website) && <span class="mod-dot">·</span>}
                      {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
                      {p.email && p.website && <span class="mod-dot">·</span>}
                      {p.website && (
                        <a href={p.website} target="_blank" rel="noopener nofollow">
                          {p.website.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                        </a>
                )}
                    </p>
                  </div>
                </details>
                ) : (
                  <div class="prov is-flat">
                    <div class="prov-row">
                      <span class="prov-name">{p.name}</span>
                      <span class="prov-sum">{p.summary}</span>
                      {p.areas && <span class="prov-areas">{p.areas}</span>}
                    </div>
                  </div>
                )
              ))}
            </div>
          </section>
        ))}
