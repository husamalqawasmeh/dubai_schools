---
import Base from "../../layouts/Base.astro";
import { allSchools } from "../../lib/db";

const schools = await allSchools();
const names = schools.map((s) => s.name);

/**
 * Nothing is selected until someone selects it.
 *
 * Defaulting to the first tab put the school form in front of every visitor,
 * most of whom are parents — and a form already open is a form that says "fill
 * me in", whoever you are. Choosing is one click, and it is the click that
 * makes the rest of the page mean something.
 */
/**
 * The old section words redirect; the tab ids do not.
 *
 * "?as=schools" and "?as=parents" are what /contribute used to carry to say
 * which audience you were — they name a section, which now lives in the path,
 * so they redirect to it and drop the query. The tab ids are singular
 * ("school", "parent", "site") and still select a tab here, which is why the
 * two cannot be collapsed into one set: ?as=school opens the school-details
 * form on this page, ?as=schools leaves it.
 */
const section = (Astro.url.searchParams.get("as") ?? "").toLowerCase();
if (section === "schools") return Astro.redirect("/schools/communicate", 301);
if (section === "parents") return Astro.redirect("/parents/communicate", 301);
/* The site-admin tab has its own page now. It was never the same kind of
   thing as the other two — they collect something, it lets a person in —
   and it sat here putting the console's front door inside a form meant
   for parents and schools. The old address still works. */
if (section === "site") return Astro.redirect("/admin/admin", 301);

/* And ?as=parent is gone too. This page is in the parents' section, so
   naming the audience again in a query string said the same thing twice —
   the form it selected is now just what the page is. The address still
   redirects: it was the target of ten "Tell us" links across the site. */
if (section === "parent") return Astro.redirect("/parents/communicate", 301);

/* The school form is no longer offered here — this page is the parents'
   one and says so with a single tab. Anyone arriving with the old query
   goes to the page that does still carry that form. */
if (section === "school") return Astro.redirect("/schools/communicate", 301);

/* Defaults to the parent form rather than to nothing.

   It opened blank when this was one page for three audiences and choosing
   was the click that made the rest mean something. The split settled that
   question in the path — anyone here is in the parents' section — so the
   blank state now asks a question it already has the answer to. The other
   tabs stay reachable above the form. */
const active = (Astro.url.searchParams.get("as") ?? "parent").toLowerCase();

/**
 * One action per audience for now.
 *
 * Students deliberately get a school-level comment box and nothing that
 * invites naming a teacher. Named criticism of an identifiable person,
 * written by a minor, is a defamation and safeguarding problem rather than a
 * feature — recognition of good teaching can come back later as a positive-only
 * nomination, which carries none of that risk.
 */
const TABS = [
  {
    id: "parent",
    href: "/parents/communicate",
    label: "Parents",
    kind: "info_request",
    title: "Request information",
    blurb:
      "Ask about a school — a fee that is not listed, admissions, transport, waiting lists. We will chase the answer and publish it where it helps the next parent asking.",
    messageLabel: "What would you like to know?",
    placeholder: "e.g. Does this school run a bus from Al Barsha, and what does it cost?",
    contactLabel: "Email, if you would like a reply",
  },
];

const current = TABS.find((t) => t.id === active) ?? null;
---

<Base
  title="Communicate — for parents"
  description="Parents: ask about a Dubai school — fees that are not listed, admissions, transport, waiting lists."
>
  <div class="wrap contribute">
    <div class="contribute-head">
      <a class="back" href="/parents/overview">Overview</a>
      <h1>Communicate</h1>
    </div>

    <div class="tabs is-single" role="tablist">
      {TABS.map((t) => (
        <a
          class={t.id === current?.id ? "tab is-on" : "tab"}
          href={t.href}
          role="tab"
          aria-selected={t.id === current?.id ? "true" : "false"}
        >
          {t.label}
        </a>
      ))}
    </div>

    {current && (
    <div class="tabpanel" role="tabpanel">
        <div class="panel">
          <h2>{current.title}</h2>
          <p class="muted-p">{current.blurb}</p>

          <form id="f" data-audience={current.id} data-kind={current.kind}>
            <div class="form-row">
              <div class="field">
                <label for="school_name">School</label>
                <input id="school_name" name="school_name" list="school-list" placeholder="Start typing a school name" autocomplete="off" />
                <datalist id="school-list">
                  {names.map((n) => <option value={n}></option>)}
                </datalist>
              </div>
              <div class="field">
                <label for="author_name">Your name <span class="opt">optional</span></label>
                <input id="author_name" name="author_name" placeholder="Shown with your comment, if published" autocomplete="off" />
              </div>
            </div>

            {current.contactLabel && (
              <div class="field">
                <label for="contact">{current.contactLabel} <span class="opt">never published</span></label>
                <input id="contact" name="contact" type="email" placeholder="you@example.com" autocomplete="email" />
              </div>
            )}

            <div class="field">
              <label for="message">{current.messageLabel}</label>
              <textarea id="message" name="message" rows="6" placeholder={current.placeholder} required></textarea>
            </div>

            {/* Honeypot. Hidden from people, irresistible to bots. */}
            <div class="hp" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form-foot">
              <button class="btn ad-cta" type="submit" id="send">Send for review</button>
              <p class="note" id="msg">
                Nothing appears on the site until it has been read and approved.
              </p>
            </div>
          </form>
        </div>
    </div>
    )}
  </div>
</Base>

<script>
  const form = document.getElementById("f") as HTMLFormElement | null;
  if (form) {
    const btn = document.getElementById("send") as HTMLButtonElement;
    const msg = document.getElementById("msg")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      btn.disabled = true;
      msg.textContent = "Sending…";
      msg.className = "note";

      const data = new FormData(form);
      const payload = {
        audience: form.dataset.audience,
        kind: form.dataset.kind,
        school_name: data.get("school_name") ?? "",
        author_name: data.get("author_name") ?? "",
        contact: data.get("contact") ?? "",
        message: data.get("message") ?? "",
        website: data.get("website") ?? "",
      };

      try {
        const res = await fetch("/api/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const out = (await res.json()) as { ok: boolean; error?: string };
        if (out.ok) {
          form.innerHTML =
            '<p class="thanks">Thank you — that has gone to the moderation queue. ' +
            "It will appear on the site once a moderator has read it.</p>";
        } else {
          msg.textContent = out.error ?? "That did not send. Please try again.";
          msg.className = "note is-bad";
          btn.disabled = false;
        }
      } catch {
        msg.textContent = "That did not send — check your connection and try again.";
        msg.className = "note is-bad";
        btn.disabled = false;
      }
    });
  }
</script>
