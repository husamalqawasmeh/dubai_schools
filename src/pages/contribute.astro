---
/**
 * The old address, kept alive. It was the site's only Communicate page for
 * months and is linked from outside, so it redirects rather than 404ing.
 *
 * ?as= still steers which section you land in — that is what the old links
 * carried — but it is not passed on. The section is now in the path, and the
 * page opens with nothing selected on purpose: whichever audience you are,
 * choosing is the click that makes the form below mean something.
 */
const raw = (Astro.url.searchParams.get("as") ?? "").toLowerCase();
const SCHOOL = new Set(["school", "schools"]);
return Astro.redirect(SCHOOL.has(raw) ? "/schools/communicate" : "/parents/communicate", 301);
---
