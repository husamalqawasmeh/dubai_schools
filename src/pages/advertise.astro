---
import Base from "../layouts/Base.astro";
import { stats } from "../lib/db";
import { HIDE_PAID_TIERS, getFlag } from "../lib/settings";

const s = await stats();

/**
 * Pricing is a placeholder. The tiers and what sits in each are a sensible
 * shape for a directory of this size; the numbers are the owner's call and
 * should be set before this page is promoted anywhere.
 */
const TIERS = [
  {
    id: "verified",
    name: "Verified",
    price: "Free",
    period: "",
    pitch: "Claim your page and correct what KHDA does not publish.",
    features: [
      "Claim and verify your school page",
      "Add office email, phone and website",
      "Add admin staff numbers",
      "Add transport routes and fees",
      "A “Verified by the school” mark on your listing",
    ],
    cta: "Update your school details",
    href: "/contribute?as=school",
    feature: false,
  },
  {
    id: "enhanced",
    name: "Enhanced",
    price: "AED 2,400",
    period: "per year",
    pitch: "Turn the listing into something that actually sells the school.",
    features: [
      "Everything in Verified",
      "Photo gallery and a school video",
      "Prospectus description",
      "Direct “Book a tour” and admissions links",
      "Open days and admission deadlines",
      "Monthly report: views, clicks, enquiries",
    ],
    cta: "Enquire",
    href: "/contribute?as=school",
    feature: false,
  },
  {
    id: "featured",
    name: "Featured",
    price: "AED 7,200",
    period: "per year",
    pitch: "Appear first to the parents already filtering for a school like yours.",
    features: [
      "Everything in Enhanced",
      "Top placement in your area and curriculum",
      "A slot on the home page",
      "Highlighted card in search results",
      "Comparison of schools",
      "Enquiries forwarded the same day",
    ],
    cta: "Enquire",
    href: "/contribute?as=school",
    feature: true,
  },
];

const hidePaid = await getFlag(HIDE_PAID_TIERS);
// The free tier is what the page is for; the priced ones are what an admin can
// take down while they are being decided.
const tiers = hidePaid ? TIERS.filter((t) => t.price === "Free") : TIERS;
---

<Base
  title="Advertise — Dubai Schools"
  description="Packages for Dubai schools: claim your listing free, or reach parents already filtering for a school like yours."
>
  <div class="wrap advertise">
    <div class="ad-head">
      <a class="back" href="/">Overview</a>
      <h1>Reach parents who are already looking</h1>
      <p class="faq-line">
        Every one of the {s.total} schools KHDA registers has a page here.
        Correcting your own school data will not cost you anything.
      </p>
      <div class="ad-stats">
        <div><b>{s.total}</b><span>Schools listed</span></div>
        <div><b>{s.areas}</b><span>Areas covered</span></div>
        <div><b>{s.curricula}</b><span>Curricula</span></div>
        <div><b>3,100+</b><span>Per-grade fee sheets</span></div>
      </div>
    </div>

    <div class="tiers">
      {tiers.map((t) => (
        <div class={t.feature ? "tier-card is-feature" : "tier-card"}>
          {t.feature && <span class="tier-flag">Most visible</span>}
          <h2>{t.name}</h2>
          <p class="tier-price">
            {t.price}
            {t.period && <span>{t.period}</span>}
          </p>
          <p class="tier-pitch">{t.pitch}</p>
          <ul>
            {t.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
          <a class="btn ad-cta" href={t.href}>{t.cta}</a>
        </div>
      ))}
    </div>
  </div>
</Base>
