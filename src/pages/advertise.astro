---
import Base from "../layouts/Base.astro";
import { stats } from "../lib/db";
import { HIDE_PAID_TIERS, getFlag } from "../lib/settings";

const s = await stats();

/**
 * Pricing is a placeholder. The tiers and what sits in each are a sensible
 * shape for a directory of this size; the numbers are the owner's call and
 * should be set before this page is promoted anywhere.
 */
const TIERS = [
  {
    id: "verified",
    name: "Verified",
    price: "Free",
    period: "",
    pitch: "Claim your page and correct what KHDA does not publish.",
    features: [
      "Claim and verify your school page",
      "Add office email, phone and website",
      "Add teacher and admin staff numbers",
      "Add transport routes and fees",
      "A “Verified by the school” mark on your listing",
    ],
    cta: "Update your school details",
    href: "/contribute?as=school",
    feature: false,
  },
  {
    id: "enhanced",
    name: "Enhanced",
    price: "AED 2,400",
    period: "per year",
    pitch: "Turn the listing into something that actually sells the school.",
    features: [
      "Everything in Verified",
      "Photo gallery and a school video",
      "Full prospectus description, not the generated one",
      "Direct “Book a tour” and admissions links",
      "Open days and admission deadlines",
      "Monthly report: views, clicks, enquiries",
    ],
    cta: "Enquire",
    href: "/contribute?as=school",
    feature: false,
  },
  {
    id: "featured",
    name: "Featured",
    price: "AED 7,200",
    period: "per year",
    pitch: "Appear first to the parents already filtering for a school like yours.",
    features: [
      "Everything in Enhanced",
      "Top placement in your area and curriculum",
      "A slot on the home page",
      "Highlighted card in search results",
      "Side-by-side comparison against similar schools",
      "Enquiries forwarded the same day",
    ],
    cta: "Enquire",
    href: "/contribute?as=school",
    feature: true,
  },
];

const FAQ = [
  {
    q: "Does paying change our KHDA rating or our position in the ratings panel?",
    a: "No. Inspection ratings, fees and the figures in the infographics come from KHDA and are never altered. Placement in a filtered list is the only thing a package affects, and sponsored placement is labelled as such wherever it appears.",
  },
  {
    q: "We only want to fix wrong information. Does that cost anything?",
    a: "No. Correcting your own data is free and always will be — a directory with wrong fees in it is worth less to everyone, including us. Use the Contribute page.",
  },
  {
    q: "How do parents find us today?",
    a: `Every school has a page, and the directory is filterable by curriculum, area, KHDA rating and fee band. There are ${s.total} schools listed, so a parent narrowing to one curriculum in one area is already seeing a short list.`,
  },
  {
    q: "Can we advertise a school that is not listed?",
    a: "The directory follows KHDA's register, so if you are registered with KHDA you are already here. If you are not listed, tell us and we will look at why.",
  },
];

const hidePaid = await getFlag(HIDE_PAID_TIERS);
// The free tier is what the page is for; the priced ones are what an admin can
// take down while they are being decided.
const tiers = hidePaid ? TIERS.filter((t) => t.price === "Free") : TIERS;
---

<Base
  title="Advertise — Dubai Schools"
  description="Packages for Dubai schools: claim your listing free, or reach parents already filtering for a school like yours."
>
  <div class="wrap advertise">
    <div class="ad-head">
      <a class="back" href="/">Overview</a>
      <h1>Reach parents who are already looking</h1>
      <p class="ad-lede">
        Every one of the {s.total} schools KHDA registers has a page here.
        Claiming yours costs nothing.
        {hidePaid
          ? " Paid placement is not open at the moment; claim your listing and we will tell you when it is."
          : " The packages below are for schools that want to be found first by the parents filtering for exactly what they offer."}
      </p>
      <div class="ad-stats">
        <div><b>{s.total}</b><span>Schools listed</span></div>
        <div><b>{s.areas}</b><span>Areas covered</span></div>
        <div><b>{s.curricula}</b><span>Curricula</span></div>
        <div><b>3,100+</b><span>Per-grade fee sheets</span></div>
      </div>
    </div>

    <div class="tiers">
      {tiers.map((t) => (
        <div class={t.feature ? "tier-card is-feature" : "tier-card"}>
          {t.feature && <span class="tier-flag">Most visible</span>}
          <h2>{t.name}</h2>
          <p class="tier-price">
            {t.price}
            {t.period && <span>{t.period}</span>}
          </p>
          <p class="tier-pitch">{t.pitch}</p>
          <ul>
            {t.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
          <a class="btn ad-cta" href={t.href}>{t.cta}</a>
        </div>
      ))}
    </div>

    <div class="ad-note">
      <strong>What money does not buy.</strong> KHDA ratings, published fees
      and the figures in the infographics are never changed by a package.
      Sponsored placement is always labelled. A parent who cannot trust the
      numbers here is worth nothing to a school advertising in them.
    </div>

    <h2 class="ad-h2">Questions</h2>
    <div class="faq">
      {FAQ.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>

    <div class="ad-foot">
      <h2>Talk to us</h2>
      <p>
        Tell us which school you are, and what you want parents to see. We will
        come back with what fits.
      </p>
      <a class="btn ad-cta" href="/contribute?as=school" style="max-width:260px">Update your school details</a>
    </div>
  </div>
</Base>
