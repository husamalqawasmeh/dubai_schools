---
/**
 * The old address, kept alive.
 *
 * /faq was in the nav, and linked from the supplies and travel-time pages and
 * from anywhere outside the site that had ever seen it. A rename without
 * something left here turns all of those into 404s, including the ones I
 * cannot see.
 *
 * Parents by default: they are most of the traffic, and both pages carry the
 * same questions today.
 */
const as = (Astro.url.searchParams.get("as") ?? "").toLowerCase();
const schools = as === "school" || as === "schools";
return Astro.redirect(schools ? "/schools/faq" : "/parents/faq", 301);
---
