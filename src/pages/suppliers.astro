---
import Base from "../layouts/Base.astro";
import { env } from "cloudflare:workers";
import { BANDS, CATEGORIES, LIMITS } from "../lib/providers";

/**
 * Suppliers and services: the directory, and the form that fills it.
 *
 * This replaced a page of general advice about where to buy things. The advice
 * was fine and is still on the parents' and schools' supplies pages; what it
 * could not do was name anyone, because naming shops we had not checked was
 * the thing we were avoiding. A register the suppliers fill in themselves, with
 * an approval step in front of it, is the version of that which can name names.
 *
 * The empty state is one line, not a panel. Three lines of consolation above
 * the form that fixes it was the wrong way round: it says "nothing here yet",
 * and that needs a sentence.
 *
 * Only approved rows are read. The filter is in the query rather than applied
 * after it, so there is no arrangement of this page that shows a pending one.
 */
const DB = (env as unknown as { DB: D1Database }).DB;

const { results } = await DB.prepare(
  `SELECT id, name, category, summary, detail, areas, phone, email, website
     FROM providers
    WHERE status = 'approved'
    ORDER BY category, name COLLATE NOCASE`
).all<any>();

const live = results ?? [];
/* Grouped into the four bands the page shows, and every band is kept whether
   or not it has anything in it — an empty one tells a reader nobody supplies
   that yet, and tells a supplier there is a place for them. */
const byBand = BANDS.map((b) => ({
  ...b,
  items: live.filter((p) => (b.of as readonly string[]).includes(p.category)),
}));

/* What the form has just done, if anything. Carried in the query string
   because the post redirects — a message held in a variable would not survive
   that, and a page that silently reloads after a submission looks broken. */
const sent = Astro.url.searchParams.get("sent") === "1";
const err = Astro.url.searchParams.get("err");
const ERRORS: Record<string, string> = {
  "1": "A name, a one-line summary and a category are needed.",
  "2": "Add at least one way to reach you — a phone number, an email address or a website.",
  "3": "That is several registrations from this connection in the last hour. Try again later, or write to us instead.",
};
---

<Base
  nonav
  title="School Supplies and Services in Dubai"
  description="Uniforms, textbooks, second-hand books, stationery, transport, tutoring and activities for Dubai schools — and a form for suppliers to register their own service."
>
  <div class="wrap pick">
    <a class="back" href="/">Home</a>
    <h1 style="margin-top:14px">School Supplies and Services</h1>
    <p class="sub">
      Suppliers serving Dubai schools. For what to buy and when — and what a
      school usually provides — see the
      <a href="/parents/school-supplies">buying guide</a>.
    </p>

        {byBand.map((c) => (
          <section class="prov-group" id={`cat-${c.id}`}>
              <div class="prov-bandhead">
                <h2 class="prov-band">{c.label}<span>{c.items.length}</span></h2>
                {c.items.length === 0 && (
                  <span class="prov-none">Nothing listed here yet.</span>
                )}
              </div>
            <div class="prov-list">
              {c.items.map((p) => (
                /* One line that opens. A directory is scanned before it is
                   read, so the closed state is the whole line — name, what
                   they do, where — and everything else waits behind it.
                   details/summary rather than a script: it works with
                   JavaScript off and the browser handles the keyboard. */
                <details class="prov">
                  <summary>
                    <span class="prov-name">{p.name}</span>
                    <span class="prov-sum">{p.summary}</span>
                    {p.areas && <span class="prov-areas">{p.areas}</span>}
                  </summary>
                  <div class="prov-body">
                    {p.detail && <p class="prov-detail">{p.detail}</p>}
                    <p class="prov-contact">
                      {p.phone && <a href={`tel:${p.phone.replace(/[^+\d]/g, "")}`}>{p.phone}</a>}
                      {p.phone && (p.email || p.website) && <span class="mod-dot">·</span>}
                      {p.email && <a href={`mailto:${p.email}`}>{p.email}</a>}
                      {p.email && p.website && <span class="mod-dot">·</span>}
                      {p.website && (
                        <a href={p.website} target="_blank" rel="noopener nofollow">
                          {p.website.replace(/^https?:\/\//, "").replace(/\/$/, "")}
                        </a>
                      )}
                    </p>
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}

    <section class="panel prov-form" id="register" style="margin-top:12px">
      <h2>Register a service</h2>
      <p class="muted-p">
        This page is for businesses supplying Dubai schools or the families at
        these schools. Any registration will be reviewed before approval.
      </p>

      {sent && (
        <p class="prov-note is-good">
          Received. It will appear here once we have looked at it. Nothing else
          is needed from you.
        </p>
      )}
      {err && ERRORS[err] && <p class="prov-note is-bad">{ERRORS[err]}</p>}

      <form method="POST" action="/api/providers/register">
        <div class="form-row">
          <div class="field">
            <label for="p-name">Business name</label>
            <input class="tt-input" id="p-name" name="name" maxlength={LIMITS.name} required autocomplete="organization" />
          </div>
          <div class="field">
            <label for="p-cat">What you supply</label>
            <select class="tt-input" id="p-cat" name="category" required>
              <option value="">Choose one</option>
              {CATEGORIES.map((c) => <option value={c.id}>{c.label}</option>)}
            </select>
          </div>
        </div>

        <div class="field">
          <label for="p-sum">Description</label>
          <input class="tt-input" id="p-sum" name="summary" maxlength={LIMITS.summary} required
                 placeholder="e.g. School uniforms for twelve Dubai schools, fitted in store or online" />
        </div>

        <div class="field">
          <label for="p-detail">Anything else worth knowing <span class="prov-opt">optional</span></label>
          <textarea class="tt-input" id="p-detail" name="detail" rows="4" maxlength={LIMITS.detail}
                    placeholder="Which schools you supply, opening hours, delivery, anything a parent would want to know before calling."></textarea>
        </div>

        <div class="field">
          <label for="p-areas">Areas you serve <span class="prov-opt">optional</span></label>
          <input class="tt-input" id="p-areas" name="areas" maxlength={LIMITS.areas} placeholder="e.g. Al Barsha, Jumeirah, or online across the UAE" />
        </div>

        <div class="form-row">
          <div class="field">
            <label for="p-phone">Phone</label>
            <input class="tt-input" id="p-phone" name="phone" maxlength={LIMITS.phone} autocomplete="tel" />
          </div>
          <div class="field">
            <label for="p-email">Email</label>
            <input class="tt-input" id="p-email" name="email" type="email" maxlength={LIMITS.email} autocomplete="email" />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="p-web">Website</label>
            <input class="tt-input" id="p-web" name="website" maxlength={LIMITS.website} placeholder="example.ae" />
          </div>
          <div class="field">
            <label for="p-contact">Your name <span class="prov-opt">not published</span></label>
            <input class="tt-input" id="p-contact" name="contact_name" maxlength={LIMITS.contact_name} autocomplete="name" />
          </div>
        </div>

        {/* Cancel clears the form rather than leaving the page. That is the
            opposite of what Cancel does on the admin account screen, and for
            a reason: there the page has one purpose and leaving it is what
            cancelling means, whereas here the form sits under a directory
            somebody may well have come to read. Sending them away from it
            would be a strange thing for a Cancel button to do. */}
        <span class="formactions prov-actions">
          <button class="formbtn" type="submit">Register</button>
          <button class="formbtn" type="reset">Cancel</button>
        </span>
      </form>
    </section>

    <p class="note-foot">
      A listing here is not a recommendation. We check that a business exists
      and that its details are real; we do not inspect it, and nothing on this
      page is paid for. Something wrong with a listing, or want yours taken
      down? <a href="/parents/communicate">Tell us</a>.
    </p>
  </div>
</Base>
