---
import Base from "../layouts/Base.astro";
import Coins from "../components/Coins.astro";
import { allSchools, gradeFees, type School } from "../lib/db";

/**
 * One school a week, chosen by the date rather than at random, so everyone
 * looking in the same week sees the same school and it changes exactly once,
 * at the start of the week. Rated schools only: featuring a school KHDA has
 * not inspected would be presenting an unknown as a recommendation.
 *
 * At 210 eligible schools a weekly rotation takes just over four years to
 * come round again, which is the point — every school gets a turn and none of
 * it is for sale.
 */
const all: School[] = await allSchools();
const eligible = all.filter((s) => s.khda_rating !== "Not rated" && s.fee_max_aed);

const today = new Date();
const dayNumber = Math.floor(
  Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate()) / 86_400_000
);
// Day 0 of the epoch was a Thursday, so shift by 4 to land week boundaries on
// a Monday rather than mid-week.
const weekNumber = Math.floor((dayNumber + 4) / 7);
const school = eligible[weekNumber % eligible.length];

// The Monday that this week's pick started on.
const monday = new Date((weekNumber * 7 - 4) * 86_400_000);
const grades = await gradeFees(school.id);

const aed = (v: number) => "AED " + v.toLocaleString("en-AE");
const bandLabel: Record<string, string> = {
  acceptable: "Acceptable", medium: "Medium", high: "Higher", very_high: "Highest",
};
const bandDots: Record<string, number> = { acceptable: 1, medium: 2, high: 3, very_high: 4 };

const cheapest = grades.find((g) => g.tuition_aed);
const dearest = [...grades].reverse().find((g) => g.tuition_aed);
const transport = grades.find((g) => g.transport)?.transport ?? null;

const dateLabel =
  "Week of " +
  monday.toLocaleDateString("en-GB", {
    day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
  });
---

<Base
  title={`Today's-spotlight — ${school.name}`}
  description={`This week's featured Dubai school: ${school.name} in ${school.area}.`}
>
  <div class="wrap pick">
    <a class="back" href="/overview">Overview</a>
    <p class="pick-date">{dateLabel}</p>
    <h1>{school.name}</h1>
    <p class="pick-where">
      {school.area} · {school.curricula.join(" / ")}
      {school.grade_range ? ` · ${school.grade_range}` : ""}
    </p>

    <div class="pick-grid">
      <div class="pane">
        <h3>Why it is this week's pick</h3>
        <p class="pick-body">
          Rated <strong>{school.khda_rating}</strong> by KHDA, teaching the
          {school.curricula.length > 1 ? " " : " "}{school.curricula.join(" and ")} curriculum
          in {school.area}.
          {cheapest && dearest && cheapest.tuition_aed && dearest.tuition_aed
            ? ` Tuition runs from ${aed(cheapest.tuition_aed)} in ${cheapest.grade} to ${aed(dearest.tuition_aed)} in ${dearest.grade}${cheapest.academic_year ? ` for ${cheapest.academic_year}` : ""}.`
            : ""}
        </p>
        <p class="pick-note">
          Picked by the date, not by anyone paying for it. Every rated school in
          the directory takes its turn.
        </p>
      </div>

      <div class="pane">
        <h3>At a glance</h3>
        <dl class="pick-facts">
          <div class="kv"><dt>KHDA rating</dt><dd>{school.khda_rating}</dd></div>
          <div class="kv"><dt>Area</dt><dd>{school.area}</dd></div>
          <div class="kv"><dt>Grades</dt><dd>{school.grade_range ?? "—"}</dd></div>
          <div class="kv">
            <dt>Fee band</dt>
            <dd>
              {school.fee_band ? (
                <span style="display:inline-flex;align-items:flex-end;gap:6px">
                  <Coins n={bandDots[school.fee_band]} label={bandLabel[school.fee_band]} />
                  {bandLabel[school.fee_band]}
                </span>
              ) : "Not published"}
            </dd>
          </div>
          {transport && <div class="kv"><dt>Transport</dt><dd>AED {transport}</dd></div>}
          {grades.length > 0 && (
            <div class="kv"><dt>Fee sheets</dt><dd>{grades.length} grades</dd></div>
          )}
        </dl>
        <a class="btn ad-cta" href={`/schools/${school.slug}`}>See the full page</a>
      </div>
    </div>
  </div>
</Base>
