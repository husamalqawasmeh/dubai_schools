---
/**
 * The old address, kept alive — same reason as /faq, /contribute and
 * /pick-of-the-week. Parents by default: they buy the uniform.
 */
const as = (Astro.url.searchParams.get("as") ?? "").toLowerCase();
const schools = as === "school" || as === "schools";
return Astro.redirect(schools ? "/schools/supplies" : "/parents/supplies", 301);
---
