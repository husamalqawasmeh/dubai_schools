---
import Base from "../layouts/Base.astro";

/**
 * Where to buy the things a school year needs.
 *
 * Deliberately generic about retailers and specific about method. Which shop
 * stocks which school's uniform changes every year, and a list of shop names
 * would rot faster than anything else on this site — so each section says how
 * to find the right supplier rather than naming one and hoping.
 */
const SECTIONS = [
  {
    title: "Uniform",
    lead: "Most schools appoint a supplier and publish the name themselves — start with the school's own website or the admissions pack rather than searching.",
    points: [
      "Buy the compulsory items from the appointed supplier: the badge, the house colours and the PE kit usually have to match exactly.",
      "Everything unbranded — plain trousers, plain shirts, socks, PE shorts — can be bought anywhere, and usually for a fraction of the price.",
      "Order early. Supplier stock runs down in the last two weeks of August and sizes go first.",
      "Buy one size up for anything worn daily. A year is a long time in a growing child.",
    ],
  },
  {
    title: "Books",
    lead: "Which books, and whether the school supplies them, depends entirely on the curriculum — ask before buying anything.",
    points: [
      "Many British and IB schools include books in the fees or lend them for the year. Indian and MOE-curriculum schools more often expect families to buy.",
      "The large Dubai bookshops carry the common curriculum titles and will order what they do not hold. Give them the ISBN, not the title — editions matter.",
      "Digital editions are often cheaper and, for heavier subjects, kinder to a school bag.",
      "Check the edition against the school's list. A prior edition is not usually a saving once page numbers stop matching in class.",
    ],
  },
  {
    title: "Stationery and equipment",
    lead: "The generic half of the list — pens, files, geometry sets, calculators — costs the same everywhere and needs no special supplier.",
    points: [
      "Hypermarkets and the stationery chains cover almost all of it, and run back-to-school pricing through August.",
      "Two items are worth buying exactly as specified: the calculator and, where required, the laptop or tablet. Examination boards restrict which calculator models are permitted, and schools standardise devices for a reason.",
      "Label everything. Every school office in Dubai has a lost property box nobody claims from.",
    ],
  },
  {
    title: "Second-hand",
    lead: "Uniforms outgrown in a year and books used for one term are the two things most worth buying used.",
    points: [
      "Many schools run a pre-loved uniform sale, often through the parent association. Ask the office — these are rarely advertised outside the school.",
      "Parent groups on messaging apps and community boards are where most of this trade actually happens.",
      "The general classifieds sites carry uniform and textbook listings, heaviest in the weeks either side of a term ending.",
    ],
  },
];
---

<Base
  title="School supplies in Dubai — uniform, books and equipment"
  description="Where to get uniform, textbooks, stationery and equipment for a Dubai school, what the school supplies itself, and what is worth buying second-hand."
>
  <div class="wrap pick">
    <a class="back" href="/">Overview</a>
    <h1 style="margin-top:14px">School supplies</h1>
    <p class="sub">
      Uniform, books, stationery and equipment — what the school provides, what
      you buy, and where the money is usually wasted.
    </p>

    <div class="supply-grid">
      {SECTIONS.map((s) => (
        <section class="supply-card">
          <h3>{s.title}</h3>
          <p>{s.lead}</p>
          <ul>{s.points.map((p) => <li>{p}</li>)}</ul>
        </section>
      ))}
    </div>

    <p class="note-foot">
      Ask the school for its own list before buying anything. Requirements differ
      by curriculum and by year group, and a supplier that was right last August
      may not be this one — which is why this page describes how to find the
      right answer rather than naming shops that would be out of date by the time
      you read it. Know something worth adding?
      <a href="/contribute">Tell us</a>.
    </p>
  </div>
</Base>
