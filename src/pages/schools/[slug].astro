---
import Base from "../../layouts/Base.astro";
import { schoolBySlug, gradeFees } from "../../lib/db";
import Coins from "../../components/Coins.astro";

const { slug } = Astro.params;
const school = await schoolBySlug(slug!);

if (!school) {
  return new Response(null, { status: 404, statusText: "School not found" });
}

const grades = school ? await gradeFees(school.id) : [];

// Everything below the per-grade table is the same on every sheet for a
// school, so it is shown once rather than repeated fourteen times.
const sample = grades.find((g) => g.transport || g.discounts.length || g.increase_policy);
const feeYearFromSheets = grades[0]?.academic_year ?? null;

const aed = (v: number) => "AED " + v.toLocaleString("en-AE");

/** KHDA publishes a range, only an upper bound, or nothing at all. */
function feeRange(): string | null {
  if (school!.fee_min_aed && school!.fee_max_aed) return `${aed(school!.fee_min_aed)} – ${aed(school!.fee_max_aed)}`;
  if (school!.fee_max_aed) return `up to ${aed(school!.fee_max_aed)}`;
  return null;
}
const fee = feeRange();

const bandLabel: Record<string, string> = {
  acceptable: "Acceptable", medium: "Medium", high: "High", very_high: "Very high",
};
const bandDots: Record<string, number> = { acceptable: 1, medium: 2, high: 3, very_high: 4 };

const mapQuery = encodeURIComponent(`${school.name}, ${school.address ?? "Dubai"}`);

const facts: { k: string; v: string | null }[] = [
  { k: school.curricula.length > 1 ? "Curricula" : "Curriculum", v: school.curricula.join(", ") },
  { k: "Grades", v: school.grade_range },
  { k: "Area", v: school.area },
  { k: "KHDA rating", v: school.khda_rating },
  { k: "Students", v: school.students_total ? school.students_total.toLocaleString("en-AE") : null },
];
---

<Base
  title={`${school.name} — fees, curriculum and KHDA rating`}
  description={school.description ?? `${school.name} in ${school.area}, Dubai.`}
>
  <div class="detail-head">
    <div class="wrap">
      <a class="back" href="/">&larr; All schools</a>
      <h1 style="margin-top:14px">{school.name}</h1>
    </div>
  </div>

  <div class="wrap">
    <div class="detail-grid">
      <div>
        <h2>Fees by grade</h2>
        {grades.length > 0 ? (
          <>
            <p style="color:var(--muted);font-size:14px;margin:6px 0 12px">
              KHDA fee sheet{feeYearFromSheets ? `, academic year ${feeYearFromSheets}` : ""}.
              Total is tuition plus the mandatory extras.
            </p>
            <div class="tbl-wrap">
              <table class="gradetbl">
                <thead>
                  <tr><th>Grade</th><th class="num">Tuition</th><th class="num">Mandatory</th><th class="num">Total</th></tr>
                </thead>
                <tbody>
                  {grades.map((g) => (
                    <tr>
                      <td>{g.grade}</td>
                      <td class="num">{g.tuition_aed ? g.tuition_aed.toLocaleString("en-AE") : "—"}</td>
                      <td class="num">
                        {g.mandatory.length
                          ? g.mandatory.map((m) => `${m.name} ${m.amount}`).join(", ")
                          : "—"}
                      </td>
                      <td class="num strong">{g.total_aed ? g.total_aed.toLocaleString("en-AE") : "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>

            {sample && (
              <div class="factgrid">
                {sample.transport && (
                  <div class="fact">
                    <h3>School transport</h3>
                    <p>AED {sample.transport} per year</p>
                  </div>
                )}
                {sample.supplies.length > 0 && (
                  <div class="fact">
                    <h3>Supplies</h3>
                    <p>{sample.supplies.map((s) => `${s.name} AED ${s.amount}`).join(" · ")}</p>
                  </div>
                )}
                {sample.optional.filter((o) => !/transport/i.test(o.name)).length > 0 && (
                  <div class="fact">
                    <h3>Optional services</h3>
                    <p>{sample.optional.filter((o) => !/transport/i.test(o.name)).map((o) => `${o.name} AED ${o.amount}`).join(" · ")}</p>
                  </div>
                )}
                {sample.discounts.length > 0 && (
                  <div class="fact">
                    <h3>Discounts</h3>
                    <p>{sample.discounts.join(" · ")}</p>
                  </div>
                )}
                {sample.increase_policy && (
                  <div class="fact wide">
                    <h3>Fee increase policy</h3>
                    <p>{sample.increase_policy}</p>
                  </div>
                )}
              </div>
            )}
          </>
        ) : (
          <div class="panel" style="margin-top:12px">
            <p class="missing" style="margin:0">
              KHDA publishes no per-grade fee sheet for this school.
            </p>
          </div>
        )}

        <h2 style="margin-top:34px">School details</h2>
        <div class="panel" style="margin-top:12px">
          <p class="missing" style="margin:0">
            Office email, teacher and admin staff numbers are not published by
            KHDA. Schools can send them through the
            <a href="/contribute?as=school">Contribute</a> page.
          </p>
        </div>

        <h2 style="margin-top:34px">Parent feedback</h2>
        <div class="panel" style="margin-top:12px">
          <p class="missing" style="margin:0">
            Not open yet. Feedback will be moderated before it appears, and no
            summary is shown until a school has at least five responses.
          </p>
        </div>
      </div>

      <aside>
        <div class="mapcard">
          <iframe
            title={`Map showing ${school.name}`}
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>

        <div class="panel">
          <p style="font-family:var(--display);font-size:10.5px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin:0 0 6px">
            Annual fees
          </p>
          {fee ? (
            <>
              <span class="feebig">{fee}</span>
              <span class="feeyear">
                {school.fee_year ? `KHDA published, ${school.fee_year}` : "KHDA published, year not stated"}
              </span>
              {school.fee_band && (
                <p style="margin:12px 0 0;display:flex;align-items:flex-end;gap:8px;font-family:var(--display);font-size:13px;color:var(--ink-2)">
                  <Coins n={bandDots[school.fee_band]} label={bandLabel[school.fee_band]} />
                  <span style="padding-bottom:2px">{bandLabel[school.fee_band]} for Dubai</span>
                </p>
              )}
            </>
          ) : (
            <p class="missing" style="margin:0">KHDA publishes no fee for this school.</p>
          )}

          <dl style="margin-top:16px;padding-top:15px;border-top:1px solid var(--rule)">
            {facts.filter((f) => f.v).map((f) => (
              <div class="kv"><dt>{f.k}</dt><dd>{f.v}</dd></div>
            ))}
          </dl>

          {school.website && <a class="btn" href={school.website} target="_blank" rel="noopener noreferrer">Visit school website</a>}
          {school.phone && <a class="btn sec" href={`tel:${school.phone}`}>{school.phone}</a>}
          <a class="btn sec" href={`https://www.google.com/maps/search/?api=1&query=${mapQuery}`} target="_blank" rel="noopener noreferrer">
            Open in Google Maps
          </a>

          <p style="font-family:var(--display);font-size:11.5px;color:var(--muted);margin:14px 0 0;line-height:1.45">
            Figures as published by KHDA. Confirm current fees and availability
            with the school directly.
          </p>
        </div>
      </aside>
    </div>
  </div>
</Base>
