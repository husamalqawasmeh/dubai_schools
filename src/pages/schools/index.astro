---
import Base from "../../layouts/Base.astro";
import { allSchools, type School } from "../../lib/db";
import Coins from "../../components/Coins.astro";
import MultiSelect from "../../components/MultiSelect.astro";

const p = Astro.url.searchParams;

/** Every facet is multi-select, carried as a comma-separated list so the URL
 *  stays readable: ?curriculum=British,IB&rating=Outstanding,Very Good */
const list = (k: string) =>
  (p.get(k) ?? "").split(",").map((s) => s.trim()).filter(Boolean);

const sel = {
  curriculum: list("curriculum"),
  area: list("area"),
  rating: list("rating"),
  band: list("band"),
};
const q = p.get("q")?.trim() ?? "";
const ratedOnly = p.get("rated") === "1";

const all: School[] = await allSchools();

const bandLabel: Record<string, string> = {
  acceptable: "Acceptable", medium: "Medium", high: "Higher", very_high: "Highest",
};
const bandDots: Record<string, number> = { acceptable: 1, medium: 2, high: 3, very_high: 4 };

/** What the free-text box matches for fees: the band in words plus the real
 *  figures, so "very high" and "89440" both land. */
const feeText = (x: School) =>
  [
    x.fee_band ? bandLabel[x.fee_band] : "no fee not published",
    x.fee_min_aed ?? "",
    x.fee_max_aed ?? "",
  ]
    .join(" ")
    .toLowerCase();

// Filtered on the server so a link from the landing page works without
// JavaScript and is indexable. The client script re-runs the same rules.
// Within a facet the values are OR; across facets they are AND.
const shown = all.filter((x) => {
  const text = q.toLowerCase();
  return (
    (!text ||
      x.name.toLowerCase().includes(text) ||
      x.area.toLowerCase().includes(text) ||
      x.curricula.join(" ").toLowerCase().includes(text) ||
      feeText(x).includes(text)) &&
    (sel.curriculum.length === 0 || x.curricula.some((c) => sel.curriculum.includes(c))) &&
    (sel.area.length === 0 || sel.area.includes(x.area)) &&
    (sel.rating.length === 0 || sel.rating.includes(x.khda_rating)) &&
    (sel.band.length === 0 || sel.band.includes(x.fee_band ?? "none")) &&
    (!ratedOnly || x.khda_rating !== "Not rated")
  );
});

/* ---- option lists, each with its count over the whole directory ---- */
const tally = <T,>(items: T[], key: (t: T) => string[]) => {
  const m = new Map<string, number>();
  for (const it of items) for (const k of key(it)) m.set(k, (m.get(k) ?? 0) + 1);
  return m;
};

const curCount = tally(all, (x) => x.curricula);
const curOptions = [...curCount.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([value, count]) => ({ value, label: value, count }));

const areaCount = tally(all, (x) => [x.area]);

/**
 * KHDA numbers its areas — "Al Barsha First", "Al Warqa Third" — which makes a
 * flat list of 78 hard to scan when nine of them are really one place. Trailing
 * ordinals and compass words are stripped to find the group.
 *
 * Deliberately conservative: this only strips suffixes, so "Jumeira First" and
 * "Jumeirah Park" stay apart, which is right — they are different places, not
 * two halves of one. The single alias covers KHDA spelling the same district
 * two ways.
 */
const ORDINAL = /\s+(First|Second|Third|Fourth|Fifth|Sixth|\d+)$/i;
const COMPASS = /\s+(South|North|East|West)$/i;
const AREA_ALIAS: Record<string, string> = { Muhaisanah: "Muhaisnah" };

function areaGroup(a: string): string {
  let s = a;
  if (ORDINAL.test(s)) s = s.replace(ORDINAL, "");
  if (COMPASS.test(s)) s = s.replace(COMPASS, "");
  return AREA_ALIAS[s] ?? s;
}

const grouped = new Map<string, { count: number; children: { value: string; label: string; count: number }[] }>();
for (const [name, n] of areaCount) {
  const key = areaGroup(name);
  if (!grouped.has(key)) grouped.set(key, { count: 0, children: [] });
  const g = grouped.get(key)!;
  g.count += n;
  g.children.push({ value: name, label: name, count: n });
}
const areaGroups = [...grouped.entries()]
  .sort((a, b) => b[1].count - a[1].count || a[0].localeCompare(b[0]))
  .map(([label, g]) => ({
    label,
    count: g.count,
    children: g.children.sort((x, y) => y.count - x.count || x.label.localeCompare(y.label)),
  }));

// KHDA's tiers stay in their official order, best first — sorting these by
// count would throw away the one thing the scale actually encodes.
const TIERS = ["Outstanding", "Very Good", "Good", "Acceptable", "Weak", "Very Weak", "Not rated"];
const ratCount = tally(all, (x) => [x.khda_rating]);
const ratOptions = TIERS.filter((t) => ratCount.has(t)).map((value) => ({
  value,
  label: value,
  count: ratCount.get(value)!,
}));

const BANDS = [
  { key: "acceptable", label: "Acceptable", range: "under AED 25,000" },
  { key: "medium", label: "Medium", range: "AED 25,000 – 49,999" },
  { key: "high", label: "Higher", range: "AED 50,000 – 89,999" },
  { key: "very_high", label: "Highest", range: "AED 90,000 and above" },
  { key: "none", label: "No fee published", range: "" },
];
const bandCount = tally(all, (x) => [x.fee_band ?? "none"]);
const bandOptions = BANDS.filter((b) => bandCount.has(b.key)).map((b) => ({
  value: b.key,
  label: b.label,
  count: bandCount.get(b.key)!,
}));

// Name the active filters in the title so a filtered link reads correctly in
// search results and when shared.
const say = (xs: string[]) => xs.join(" or ");
const activeBits = [
  say(sel.curriculum),
  sel.rating.length ? `rated ${say(sel.rating)}` : "",
  say(sel.area),
  sel.band.length ? say(sel.band.map((b) => bandLabel[b] ?? "No fee published")) : "",
].filter(Boolean);
const title = activeBits.length
  ? `${activeBits.join(", ")} schools in Dubai`
  : "All Dubai schools — search and filter";
---

<Base title={title}>
  <div class="wrap listing">
    <div class="listing-top">
      <div class="listing-head">
        <div>
          <a class="back" href="/">&larr; Overview</a>
          {activeBits.length ? (
            <h1 class="criteria">
              <span class="criteria-label">Filtering criteria:</span>
              {activeBits.join(" · ")}
            </h1>
          ) : (
            <h1 style="font-size:22px;margin-top:6px">All schools</h1>
          )}
        </div>
        <p class="count"><b id="n">{shown.length}</b> <span id="noun">{shown.length === 1 ? "school" : "schools"}</span> of {all.length}</p>
      </div>

      <div class="searchbar">
        <input id="q" type="search" value={q} placeholder="Search by name, area, curriculum or fee…" aria-label="Search schools" />
        <span class="search-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="10.5" cy="10.5" r="6.5" /><path d="M15.5 15.5 21 21" />
          </svg>
        </span>
      </div>

      <div class="filters">
        <div class="row">
          <MultiSelect id="curriculum" label="Curriculum" options={curOptions} selected={sel.curriculum} allLabel="All curricula" />
          <MultiSelect id="rating" label="KHDA rating" options={ratOptions} selected={sel.rating} allLabel="All ratings" />
          <MultiSelect id="band" label="Fee band" options={bandOptions} selected={sel.band} allLabel="Any fee" />
          <MultiSelect id="area" label="Area" groups={areaGroups} selected={sel.area} allLabel="All areas" scroll />
        </div>
      </div>
    </div>

    <div class="listing-results">
      <div class="grid" id="grid">
        {all.map((x) => (
          <a
            class="card"
            href={`/schools/${x.slug}`}
            hidden={!shown.includes(x)}
            data-name={x.name.toLowerCase()}
            data-area={x.area}
            data-cur={x.curricula.join("|")}
            data-rat={x.khda_rating}
            data-band={x.fee_band ?? "none"}
            data-fee={feeText(x)}
          >
            <h3>{x.name}</h3>
            <p class="where">{x.area} · {x.curricula.join(" / ")}</p>
            <div class="foot">
              <span class="fee">
                {x.fee_band ? (
                  <>
                    <Coins n={bandDots[x.fee_band]} label={bandLabel[x.fee_band]} />
                    {bandLabel[x.fee_band]}
                  </>
                ) : (
                  <span class="missing">Fee not published</span>
                )}
              </span>
              <span class="badge" data-r={x.khda_rating}>{x.khda_rating}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="empty" id="empty" hidden={shown.length > 0}>
        No schools match these filters. Try clearing a filter or widening the fee band.
      </div>
    </div>
  </div>
</Base>

<script>
  // Every card is already in the DOM; filtering toggles them, so there is no
  // round trip and no JSON payload. The URL is kept in step so a filtered
  // view stays shareable and the back button behaves.
  interface Facet {
    key: string;
    attr: string;
    /** true when the card itself holds several values (a school may run two
     *  curricula), so the test is intersection rather than membership. */
    listValued: boolean;
    box: HTMLDetailsElement;
    summary: HTMLElement;
    inputs: HTMLInputElement[];
    allLabel: string;
  }

  const ALL_LABEL: Record<string, string> = {
    curriculum: "All curricula",
    area: "All areas",
    rating: "All ratings",
    band: "Any fee",
  };
  const LIST_VALUED: Record<string, boolean> = { curriculum: true };
  const ATTR: Record<string, string> = {
    curriculum: "cur", area: "area", rating: "rat", band: "band",
  };

  const facets: Facet[] = Array.from(
    document.querySelectorAll<HTMLDetailsElement>(".multi[data-key]")
  ).map((box) => {
    const key = box.dataset.key!;
    return {
      key,
      attr: ATTR[key],
      listValued: !!LIST_VALUED[key],
      box,
      summary: box.querySelector(".multi-summary") as HTMLElement,
      inputs: Array.from(box.querySelectorAll<HTMLInputElement>('input[type="checkbox"]:not(.grp)')),
      allLabel: ALL_LABEL[key],
    };
  });

  const q = document.getElementById("q") as HTMLInputElement;
  const grid = document.getElementById("grid")!;
  const empty = document.getElementById("empty")!;
  const n = document.getElementById("n")!;
  const noun = document.getElementById("noun")!;
  const results = document.querySelector(".listing-results")!;
  const cards = Array.from(grid.children) as HTMLElement[];

  function apply() {
    const text = q.value.trim().toLowerCase();

    const picked = facets.map((f) => {
      const on = f.inputs.filter((i) => i.checked);
      const values = on.map((i) => i.value);
      f.summary.textContent =
        values.length === 0
          ? f.allLabel
          : values.length === 1
            ? (on[0].parentElement!.querySelector(".multi-name") as HTMLElement).textContent!
            : `${values.length} selected`;
      f.box.classList.toggle("has-picks", values.length > 0);
      return { f, values };
    });

    let count = 0;
    for (const c of cards) {
      const d = c.dataset;
      let ok =
        !text ||
        d.name!.includes(text) ||
        d.area!.toLowerCase().includes(text) ||
        d.cur!.toLowerCase().includes(text) ||
        d.fee!.includes(text);

      if (ok) {
        for (const { f, values } of picked) {
          if (values.length === 0) continue;
          const cardVal = d[f.attr]!;
          const hit = f.listValued
            ? cardVal.split("|").some((v) => values.includes(v))
            : values.includes(cardVal);
          if (!hit) { ok = false; break; }
        }
      }

      c.hidden = !ok;
      if (ok) count++;
    }

    n.textContent = String(count);
    noun.textContent = count === 1 ? "school" : "schools";
    empty.hidden = count > 0;
    results.scrollTop = 0;

    const u = new URL(location.href);
    const set = (k: string, v: string) => (v ? u.searchParams.set(k, v) : u.searchParams.delete(k));
    set("q", q.value.trim());
    for (const { f, values } of picked) set(f.key, values.join(","));
    u.searchParams.delete("rated");
    history.replaceState(null, "", u);
  }

  /* ---- grouped options: a parent box toggles its children ---- */
  const groupsOf = (f: Facet) =>
    Array.from(f.box.querySelectorAll<HTMLElement>(".multi-group"));
  const kidsOf = (g: HTMLElement) =>
    Array.from(g.querySelectorAll<HTMLInputElement>(".multi-kids input"));
  const parentOf = (g: HTMLElement) => g.querySelector(".grp") as HTMLInputElement;

  function syncParents() {
    for (const f of facets)
      for (const g of groupsOf(f)) {
        const kids = kidsOf(g);
        const on = kids.filter((k) => k.checked).length;
        const p = parentOf(g);
        p.checked = on === kids.length && on > 0;
        // Some but not all: the box shows a dash rather than lying either way.
        p.indeterminate = on > 0 && on < kids.length;
      }
  }

  q.addEventListener("input", apply);
  for (const f of facets) {
    for (const i of f.inputs) i.addEventListener("change", () => { syncParents(); apply(); });

    for (const g of groupsOf(f)) {
      const p = parentOf(g);
      const kids = kidsOf(g);
      const toggle = g.querySelector(".grp-name") as HTMLButtonElement;
      const panel = g.querySelector(".multi-kids") as HTMLElement;

      p.addEventListener("change", () => {
        for (const k of kids) k.checked = p.checked;
        p.indeterminate = false;
        // Selecting a whole group and leaving it shut hides what was chosen.
        if (p.checked && panel.hidden) {
          panel.hidden = false;
          toggle.setAttribute("aria-expanded", "true");
        }
        apply();
      });

      toggle.addEventListener("click", () => {
        panel.hidden = !panel.hidden;
        toggle.setAttribute("aria-expanded", panel.hidden ? "false" : "true");
      });
    }

    const clear = f.box.querySelector(".multi-clear") as HTMLButtonElement;
    clear.addEventListener("click", () => {
      for (const i of f.inputs) i.checked = false;
      syncParents();
      apply();
    });
  }

  syncParents();

  // Close on an outside click or Escape, and never leave two panels open at
  // once — they overlap each other in a four-column row.
  document.addEventListener("click", (e) => {
    for (const f of facets) {
      if (f.box.open && !f.box.contains(e.target as Node)) f.box.open = false;
    }
  });
  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape") return;
    for (const f of facets) {
      if (f.box.open) {
        f.box.open = false;
        (f.box.querySelector("summary") as HTMLElement).focus();
      }
    }
  });
  for (const f of facets) {
    f.box.addEventListener("toggle", () => {
      if (!f.box.open) return;
      for (const o of facets) if (o !== f) o.box.open = false;
    });
  }

  apply();
</script>
