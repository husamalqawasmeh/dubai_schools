---
import Base from "../../layouts/Base.astro";
import NewsList from "../../components/NewsList.astro";
import { publishedNews, band } from "../../lib/newsfeed";

/**
 * Schools news, in three bands.
 *
 * The first band is the reader's own — their school here, their favourites on
 * the parents' page. Neither exists yet: there is no school sign-in and no
 * favourites, so nothing can be attributed to a reader and the band is empty
 * for everyone. It is rendered anyway, saying plainly what would fill it,
 * because a section that appears the day accounts arrive is a section nobody
 * knew to expect.
 *
 * The other two are decided by the story: anything tied to a listed school, or
 * naming Dubai, KHDA or the Emirates, is local; the rest reached the scan
 * without being about here.
 */
const rows = await publishedNews();
const own = new Set<number>();   // nothing to put in it until accounts exist
const { own: mine, local, other } = band(rows, own);
---

<Base
  title="Schools news — Dubai Schools"
  description="Term dates, fee decisions, inspection results, openings and closures across Dubai's private schools."
>
  <div class="wrap pick">
    <a class="back" href="/schools/overview">Overview</a>
    <h1 style="margin-top:14px">Schools news</h1>

    <section class="newsband">
      <div class="faq-group-title">
        <h2>Your school</h2>
        <span class="faq-group-n">{mine.length}</span>
      </div>
      <NewsList items={mine} empty="News about your own school will appear here once schools can sign in. That is not built yet, so this band is empty for everyone." />
    </section>

    <section class="newsband">
      <div class="faq-group-title">
        <h2>Dubai schools</h2>
        <span class="faq-group-n">{local.length}</span>
      </div>
      <NewsList items={local} empty="Nothing published yet. The scan runs every morning and each story is checked before it appears here." />
    </section>

    <section class="newsband">
      <div class="faq-group-title">
        <h2>Elsewhere</h2>
        <span class="faq-group-n">{other.length}</span>
      </div>
      <NewsList items={other} empty="Nothing here at the moment." />
    </section>

    <p class="note-foot">
      Each line is dated by the newspaper that published it; a date marked with
      an asterisk is the day we found the story, because that source gave none.
      Headlines link to the original. Nothing appears here automatically — every
      item is read before it is published.
    </p>
  </div>
</Base>
