---
import Base from "../layouts/Base.astro";
import LensLogo from "../components/LensLogo.astro";

/**
 * The front of the site: the mark, who it is for, and the way in.
 *
 * This was the admin demo. Moving it to "/" makes it the first thing anyone
 * sees, and pushes the overview to /overview — so every "back" link on the
 * site now returns to the overview rather than here, because that is the page
 * people are actually working in.
 *
 * No header. Every nav item leads somewhere behind this page, so offering them
 * here would be two ways past the same point, and the one button would stop
 * looking like the way in. The nav comes back the moment you are through.
 *
 * WHAT A SPLASH COSTS, AND HOW IT IS PAID FOR HERE
 * ------------------------------------------------
 * A front page with a logo on it has almost no text for a search engine to
 * read, and "/" is the page that ranks. So the description below carries the
 * substance, the two panels are real prose rather than images, and the way in
 * is a plain <a href> — a crawler follows it to the overview and finds all 232
 * schools behind that. A button that needed JavaScript would have made this
 * site's front door invisible.
 *
 * The bubbles bounce, and that is the only part needing a script. If it never
 * runs, the mark is still a mark and "Start the journey" still works.
 */
const WORD = "DubaiSchools";
const DROPPED = new Set([2, 7, 11]);      // b, h, s  — below the line
const RAISED = new Set([5]);              // S         — above it
/** Off the baseline either way. Brown marks a letter that has moved, not a
 *  letter that has moved *down* — otherwise S would have had to change colour
 *  just for going the other direction. */
const OFFSET = new Set([...DROPPED, ...RAISED]);

/**
 * Two colours: dark red on the line, brown off it.
 *
 * Both clear the ground comfortably — 8.5:1 for the red and 6.4:1 for the
 * brown — so unlike the eight-colour version this would hold up at body size
 * too, not only as a 46px wordmark.
 */
const BROWN = "#6f5210";

/**
 * How big each offset letter is, relative to the rest of the word.
 *
 * The size lives on an inner span, not on .idch. The drop is measured in em,
 * and em is relative to the element's own font size — so scaling .idch itself
 * would scale its drop with it, and the four letters would fall by four
 * different amounts. Outer span positions, inner span sizes.
 */
const OFFSET_SIZE: Record<number, number> = {
  2: 0.6,     // b  the three below the line are one size now
  5: 1.1,     // S  above it, and the only one larger than the word
  7: 0.6,     // h
  11: 0.6,    // s
};
/** One dark red for every letter on the line. The eight-colour version tied
 *  the name to the bubbles, but it also competed with them — a lens full of
 *  colour beside a word full of colour left neither leading. One colour on the
 *  line lets the offset letters and the mark do the talking. */
const ON_LINE = "#8c1512";
---

<Base
  bare
  title="Dubai Schools — every private school in Dubai, in one place"
  description="Compare all 232 KHDA-registered private schools in Dubai: curriculum, fees, inspection rating, area and grade range, side by side. Free, and without an account."
>
  <div class="idwrap">
    <div class="idstage">
      <LensLogo size={403} class="idmark is-reveal" />

      <div class="idcol">
        <div class="idside">
        <h1 class="idword">
          {[...WORD].map((ch, i) => (
            <span
              class={`idch${DROPPED.has(i) ? " is-low" : ""}${RAISED.has(i) ? " is-high" : ""}`}
              style={`color:${OFFSET.has(i) ? BROWN : ON_LINE}`}
            >
              {OFFSET.has(i) ? (
                <span style={`font-size:${OFFSET_SIZE[i]}em`}>{ch}</span>
              ) : (
                ch
              )}
            </span>
          ))}
        </h1>

        <div class="idsplit">
          <section class="idcard idcard-parents">
            <h2>For parents</h2>
            <p>
              Every private school in one place — curriculum, fees, KHDA rating
              and area, side by side. Free, and without an account.
            </p>
          </section>

          <section class="idcard idcard-schools">
            <h2>For schools</h2>
            <p>
              A listing you can correct, fill out and be found through — in
              front of every parent comparing schools in Dubai, at no cost.
            </p>
          </section>
        </div>

        </div>

        <div class="idgo">
          <span class="idgo-note">232 schools &middot; 78 areas &middot; no sign-up</span>
          <a class="btn idgo-btn" href="/overview">Start the journey</a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var svg = document.querySelector(".idmark");
      if (!svg) return;

      var still = window.matchMedia("(prefers-reduced-motion: reduce)");
      if (still.matches) return;

      // The wall comes from the artwork's own clip circle, so resizing the logo
      // cannot leave the physics bouncing off where the glass used to be.
      var bounds = svg.querySelector("clipPath circle");
      if (!bounds) return;
      var CX = +bounds.getAttribute("cx");
      var CY = +bounds.getAttribute("cy");
      var WALL = +bounds.getAttribute("r") - 1.5;

      var balls = [];
      svg.querySelectorAll(".bub").forEach(function (g, i) {
        var c = g.querySelector("circle");
        var x0 = +c.getAttribute("cx");
        var y0 = +c.getAttribute("cy");
        // Headings spread around the circle rather than random: random ones
        // clump, and a clump drifts as one mass.
        var a = (i / 11) * Math.PI * 2 + 0.7;
        // Slow enough to read as suspended rather than as a screensaver.
        var speed = 0.052 + (i % 4) * 0.011;
        balls.push({
          g: g, x0: x0, y0: y0, x: x0, y: y0,
          vx: Math.cos(a) * speed, vy: Math.sin(a) * speed,
          r: +c.getAttribute("r"),
        });
      });

      var last = 0;
      function step(now) {
        // Scaled to a 60fps frame so speed does not depend on the display, and
        // clamped so a backgrounded tab does not resume with one jump that
        // teleports a bubble through a wall.
        var dt = last ? Math.min((now - last) / 16.7, 3) : 1;
        last = now;

        for (var i = 0; i < balls.length; i++) {
          var b = balls[i];
          b.x += b.vx * dt;
          b.y += b.vy * dt;

          var dx = b.x - CX, dy = b.y - CY;
          var d = Math.hypot(dx, dy);
          var max = WALL - b.r;
          if (d > max) {
            var nx = dx / d, ny = dy / d;
            var dot = b.vx * nx + b.vy * ny;
            b.vx -= 2 * dot * nx;
            b.vy -= 2 * dot * ny;
            b.x = CX + nx * max;
            b.y = CY + ny * max;
          }
        }

        // Equal masses, so a collision is a swap of the velocity along the line
        // of centres. Overlapping pairs are separated first, or two bubbles
        // stick together and jitter.
        for (var a2 = 0; a2 < balls.length; a2++) {
          for (var b2 = a2 + 1; b2 < balls.length; b2++) {
            var p = balls[a2], q = balls[b2];
            var ex = q.x - p.x, ey = q.y - p.y;
            var dist = Math.hypot(ex, ey) || 0.0001;
            var need = p.r + q.r;
            if (dist >= need) continue;

            var ux = ex / dist, uy = ey / dist;
            var push = (need - dist) / 2;
            p.x -= ux * push; p.y -= uy * push;
            q.x += ux * push; q.y += uy * push;

            var pn = p.vx * ux + p.vy * uy;
            var qn = q.vx * ux + q.vy * uy;
            if (pn - qn <= 0) continue;
            var swap = pn - qn;
            p.vx -= swap * ux; p.vy -= swap * uy;
            q.vx += swap * ux; q.vy += swap * uy;
          }
        }

        for (var k = 0; k < balls.length; k++) {
          var t = balls[k];
          t.g.setAttribute(
            "transform",
            "translate(" + (t.x - t.x0).toFixed(2) + " " + (t.y - t.y0).toFixed(2) + ")"
          );
        }
        requestAnimationFrame(step);
      }

      // The last bubble starts at 300 + 10x90 and takes 520ms, so the reveal is
      // over at 1720 — not before, or CSS is still animating a bubble the
      // script has started writing to.
      setTimeout(function () {
        svg.classList.add("is-bouncing");
        requestAnimationFrame(step);
      }, 1720);
    })();
  </script>
</Base>
