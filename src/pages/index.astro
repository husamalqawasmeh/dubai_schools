---
import Base from "../layouts/Base.astro";
import { stats } from "../lib/db";

const s = await stats();

// KHDA's tiers in their official order, best first, keeping only those present.
const TIERS = ["Outstanding", "Very Good", "Good", "Acceptable", "Weak", "Very Weak", "Not rated"];
const tiersPresent = TIERS.filter((t) => s.ratings[t]);
const maxTier = Math.max(...tiersPresent.map((t) => s.ratings[t]));

const BANDS = [
  { key: "acceptable", label: "Acceptable", dots: 1, range: "under AED 25,000" },
  { key: "medium", label: "Medium", dots: 2, range: "AED 25,000 – 49,999" },
  { key: "high", label: "High", dots: 3, range: "AED 50,000 – 89,999" },
  { key: "very_high", label: "Very high", dots: 4, range: "AED 90,000 and above" },
];
const maxBand = Math.max(...BANDS.map((b) => s.bands[b.key] ?? 0));

// Top curricula by name, with the long tail folded into one row rather than
// drawn as eight bars of one or two schools each.
const TOP = 6;
const top = s.curriculaCounts.slice(0, TOP);
const tail = s.curriculaCounts.slice(TOP);
const tailTotal = tail.reduce((a, c) => a + c.n, 0);
const maxCur = top[0]?.n ?? 1;
---

<Base title="Dubai Schools — compare all 232 KHDA-registered schools">
  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">KHDA education directory</p>
      <h1>Every private school in Dubai, in one place.</h1>
      <p class="lede">
        All {s.total} schools registered with KHDA — curriculum, area, inspection
        rating and published fees. Start from any figure below to see the schools behind it.
      </p>

      <div class="stats">
        <a class="stat" href="/schools"><b>{s.total}</b><span>Schools listed</span></a>
        <a class="stat" href="/schools?rated=1"><b>{s.rated}</b><span>Inspected &amp; rated</span></a>
        <a class="stat" href="/schools"><b>{s.areas}</b><span>Areas covered</span></a>
        <a class="stat" href="/schools"><b>{s.curricula}</b><span>Curricula</span></a>
      </div>
    </div>
  </section>

  <div class="wrap" style="padding-top:38px;padding-bottom:70px">
    <h2>The shape of Dubai's schools</h2>
    <p style="color:var(--muted);font-size:14.5px;margin:6px 0 0;max-width:62ch">
      Every bar is a link. Click one to open the directory already filtered to it.
    </p>

    <div class="charts">
      <div class="chart">
        <h3>Where the ratings sit</h3>
        <p class="sub">Schools per KHDA tier. Darker is a better inspection result.</p>
        <div class="bars">
          {tiersPresent.map((t, i) => (
            <a class="bar-row" href={`/schools?rating=${encodeURIComponent(t)}`}>
              <span class="bar-lab">{t}</span>
              <span class="bar-track">
                <span
                  class={t === "Not rated" ? "bar hatch" : "bar"}
                  style={`--w:${Math.round((s.ratings[t] / maxTier) * 100)}%;--c:var(--r${Math.min(i + 1, 4)})`}
                ></span>
              </span>
              <span class="bar-val">{s.ratings[t]}</span>
            </a>
          ))}
        </div>
        <p class="sub" style="margin:13px 0 0">
          Not rated is hatched, not coloured: no inspection has happened yet,
          usually a new school. It is not a low score.
        </p>
      </div>

      <div class="chart">
        <h3>What schools cost</h3>
        <p class="sub">Fee bands, cut on the real quartiles of the {s.priced} priced schools.</p>
        <div class="bars">
          {BANDS.map((b) => (
            <a class="bar-row" href={`/schools?band=${b.key}`} title={`${b.label} — ${b.range}`}>
              <span class="bar-lab">
                <span class="meter" aria-hidden="true">
                  {[1, 2, 3, 4].map((d) => <i class={d <= b.dots ? "on" : ""}></i>)}
                </span>
                <span class="sr-only">{b.label}</span>
              </span>
              <span class="bar-track">
                <span class="bar" style={`--w:${Math.round(((s.bands[b.key] ?? 0) / maxBand) * 100)}%`}></span>
              </span>
              <span class="bar-val">{s.bands[b.key] ?? 0}</span>
            </a>
          ))}
        </div>
        <p class="sub" style="margin:13px 0 0">
          One dot {BANDS[0].range}, four dots {BANDS[3].range}.
          <a href="/schools?band=none">{s.bands["none"] ?? 0} schools</a> publish no fee at all.
        </p>
      </div>

      <div class="chart">
        <h3>Curriculum mix</h3>
        <p class="sub">Schools offering each curriculum. British leads by nearly 3&times;.</p>
        <div class="bars">
          {top.map((c) => (
            <a class="bar-row" href={`/schools?curriculum=${encodeURIComponent(c.name)}`}>
              <span class="bar-lab">{c.name}</span>
              <span class="bar-track">
                <span class="bar" style={`--w:${Math.round((c.n / maxCur) * 100)}%`}></span>
              </span>
              <span class="bar-val">{c.n}</span>
            </a>
          ))}
          {tail.length > 0 && (
            <div class="bar-row" style="cursor:default">
              <span class="bar-lab" style="color:var(--muted)">Other &times;{tail.length}</span>
              <span class="bar-track">
                <span class="bar hatch" style={`--w:${Math.round((tailTotal / maxCur) * 100)}%`}></span>
              </span>
              <span class="bar-val">{tailTotal}</span>
            </div>
          )}
        </div>
        <p class="sub" style="margin:13px 0 0">
          Counts total more than {s.total} because a school may run two
          curricula, such as British and IB.
        </p>
      </div>

      <div class="chart" style="display:flex;flex-direction:column;justify-content:center">
        <h3>Looking for something specific?</h3>
        <p class="sub" style="margin-bottom:16px">
          Search all {s.total} schools by name, area or curriculum, and narrow
          by rating and fee band.
        </p>
        <a class="btn" href="/schools" style="margin-top:0">Browse all schools</a>
        <p class="sub" style="margin:14px 0 0">
          Fees are as published by KHDA and are not all from the same academic
          year — each school's page shows its own.
        </p>
      </div>
    </div>
  </div>
</Base>
