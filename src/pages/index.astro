---
import Base from "../layouts/Base.astro";
import { stats } from "../lib/db";
import Coins from "../components/Coins.astro";

const s = await stats();

// KHDA's tiers in their official order, best first, keeping only those present.
const TIERS = ["Outstanding", "Very Good", "Good", "Acceptable", "Weak", "Very Weak", "Not rated"];
const tiersPresent = TIERS.filter((t) => s.ratings[t]);
const maxTier = Math.max(...tiersPresent.map((t) => s.ratings[t]));

const BANDS = [
  { key: "acceptable", label: "Acceptable", dots: 1, range: "under AED 25,000", short: "< 25k" },
  { key: "medium", label: "Medium", dots: 2, range: "AED 25,000 – 49,999", short: "25–50k" },
  { key: "high", label: "Higher", dots: 3, range: "AED 50,000 – 89,999", short: "50–90k" },
  { key: "very_high", label: "Highest", dots: 4, range: "AED 90,000 and above", short: "90k +" },
];

// Top curricula by name, with the long tail folded into one row rather than
// drawn as eight bars of one or two schools each.
const TOP = 6;
const top = s.curriculaCounts.slice(0, TOP);
const tail = s.curriculaCounts.slice(TOP);
const tailTotal = tail.reduce((a, c) => a + c.n, 0);
const maxCur = top[0]?.n ?? 1;
---

<Base title="Dubai Schools — compare all 232 KHDA-registered schools">
  <section class="hero">
    <div class="wrap">
      <h1>Every private school in Dubai, in one place.</h1>

      <div class="stats">
        <a class="stat" href="/schools"><b>{s.total}</b><span>Schools listed</span></a>
        <a class="stat" href="/schools?rated=1"><b>{s.rated}</b><span>Rated by KHDA</span></a>
        <a class="stat" href="/schools"><b>{s.areas}</b><span>Areas covered</span></a>
        <a class="stat" href="/schools"><b>{s.curricula}</b><span>Curricula</span></a>
      </div>
    </div>
  </section>

  <div class="wrap" style="padding-top:13px;padding-bottom:22px">
    <div class="charts charts-first">
      <div class="chart">
        <h3><span class="chart-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="9" r="6"/><path d="M8.5 14.2 7 22l5-2.6L17 22l-1.5-7.8"/></svg></span>KHDA rating</h3>
        <div class="tier-grid">
          {tiersPresent.map((t, i) => (
            <a class="tier" href={`/schools?rating=${encodeURIComponent(t)}`}>
              <span
                class={t === "Not rated" ? "tier-swatch none" : "tier-swatch"}
                style={`--c:var(--r${Math.min(i + 1, 4)})`}
                aria-hidden="true"
              ></span>
              <span class="tier-name">{t}</span>
              <span class="tier-n">{s.ratings[t]}</span>
            </a>
          ))}
        </div>
      </div>

      <div class="chart">
        <h3><span class="chart-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v5c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/><path d="M4 11v5c0 1.7 3.6 3 8 3s8-1.3 8-3v-5"/></svg></span>What schools cost</h3>
        <div class="tier-grid band-grid">
          {BANDS.map((b) => (
            <a class="tier" href={`/schools?band=${b.key}`}>
              <span class="band-coins"><Coins n={b.dots} size="lg" label={b.label} /></span>
              <span class="tier-name">{b.label}</span>
              <span class="tier-n">{s.bands[b.key] ?? 0}</span>
              <span class="band-range">{b.short}</span>
            </a>
          ))}
          <a class="tier" href="/schools?band=none">
            <span class="band-coins">
              <svg
                class="coins coins-lg coin-empty"
                viewBox="0 0 46 48"
                width="46"
                height="48"
                role="img"
                aria-label="No fee published"
              >
                <ellipse cx="23" cy="38" rx="14" ry="4.8" />
              </svg>
            </span>
            <span class="tier-name">Not published</span>
            <span class="tier-n">{s.bands["none"] ?? 0}</span>
            <span class="band-range">&nbsp;</span>
          </a>
        </div>
      </div>

      <div class="chart chart-wide">
        <h3><span class="chart-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 4.5A1.5 1.5 0 0 1 4.5 3H10a3 3 0 0 1 2 5.2V21a3 3 0 0 0-2-.8H4.5A1.5 1.5 0 0 1 3 18.7z"/><path d="M21 4.5A1.5 1.5 0 0 0 19.5 3H14a3 3 0 0 0-2 5.2V21a3 3 0 0 1 2-.8h5.5a1.5 1.5 0 0 0 1.5-1.5z"/></svg></span>Curriculum mix</h3>
        <div class="tier-grid cur-grid">
          {top.map((c) => (
            <a class="tier" href={`/schools?curriculum=${encodeURIComponent(c.name)}`}>
              <span class="cur-bar" aria-hidden="true">
                <span style={`width:${Math.round((c.n / maxCur) * 100)}%`}></span>
              </span>
              <span class="tier-name">{c.name}</span>
              <span class="tier-n">{c.n}</span>
            </a>
          ))}
          {tail.length > 0 && (
            <div class="tier tier-static">
              <span class="cur-bar hatch" aria-hidden="true">
                <span style={`width:${Math.round((tailTotal / maxCur) * 100)}%`}></span>
              </span>
              <span class="tier-name">Other &times;{tail.length}</span>
              <span class="tier-n">{tailTotal}</span>
            </div>
          )}
        </div>
        <p class="sub" style="margin:13px 0 0">
          Some schools have more than one curricula, such as British and IB.
        </p>
      </div>

      <div class="chart chart-narrow" style="display:flex;flex-direction:column;justify-content:center">
        <h3><span class="chart-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/></svg></span>Browse, filter or search</h3>
        <p class="sub" style="margin-bottom:14px">
          Search by name, area, curriculum or fee.
        </p>
        <a class="btn" href="/schools" style="margin-top:0">Browse all {s.total}</a>
      </div>
    </div>
  </div>
</Base>
