---
import Base from "../../layouts/Base.astro";
import { todayInDubai } from "../../lib/today";
import { env } from "cloudflare:workers";

const DB = (env as unknown as { DB: D1Database }).DB;

const { results } = await DB.prepare(
  `SELECT id, title, done, position, entry_date, completion_date
     FROM roadmap ORDER BY position ASC, id ASC`
).all<{
  id: number;
  title: string;
  done: number;
  position: number;
  entry_date: string | null;
  completion_date: string | null;
}>();

const items = results ?? [];

/**
 * Which row is open for editing, from the query string.
 *
 * Editing is a URL rather than a script: ?edit=7 renders that one row as a
 * form. It costs a round trip and buys a board that works with JavaScript off,
 * survives a refresh mid-edit, and can be linked to.
 */
const editing = Number(Astro.url.searchParams.get("edit") ?? 0);

/* The row itself, and its position in the list — the serial the form names is
   the same one shown beside the row, so "Editing 4" points at something the
   reader can see. An ?edit= that names nothing (a deleted row, a stale
   bookmark) leaves target null and the page falls back to the add line rather
   than showing an edit form for a row that is gone. */
const target = items.find((i) => i.id === editing) ?? null;
const targetNo = target ? items.indexOf(target) + 1 : 0;

/* The add line offers the date it was raised, filled in with today so the
   common case needs no thought — and editable, so something raised last week
   goes in with the date it actually happened rather than the date it was
   typed. Today in Dubai, not in UTC: the Worker rolls over four hours early,
   which would date an evening entry to yesterday. */
const raisedToday = todayInDubai();

const shown = (d: string | null) =>
  d ? new Date(d + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : null;
---

<Base title="Improvements and planned changes — admin">
  <div class="wrap pick rm-page">
    <a class="back" href="/admin/admin">Back to admin</a>
    <h1 style="margin-top:14px">Improvements and planned changes</h1>
    {/* One form at the top, and it is either the add line or the edit line.
        Editing used to reshape the row in place, which meant the fields
        appeared wherever that row happened to sit — halfway down a long list,
        under the mouse that had just clicked Edit. Here it is always in the
        same place, and the row stays readable while you retype it. */}
    {target ? (
      <form class="rm-add is-editing" method="POST" action="/api/admin/roadmap">
        <input type="hidden" name="action" value="edit" />
        <input type="hidden" name="id" value={target.id} />
        <span class="rm-editing-tag">Editing</span>
        {/* The serial is a position, not a stored value: typing 1 here means
            "put this first". Saving moves the row and renumbers the rest —
            the same thing the arrows do, reachable in one go. */}
        <label class="rm-serialfield">
          <span>No.</span>
          <input class="tt-input" type="number" name="serial" value={targetNo} min="1" max={items.length} />
        </label>
        <input
          class="tt-input"
          name="title"
          value={target.title}
          maxlength="300"
          required
          autocomplete="off"
          autofocus
        />
        <label class="rm-datefield">
          <span>Raised</span>
          <input class="tt-input" type="date" name="entry_date" value={target.entry_date ?? ""} />
        </label>
        <label class="rm-datefield">
          <span>Completed</span>
          <input class="tt-input" type="date" name="completion_date" value={target.completion_date ?? ""} />
        </label>
        <button class="btn rm-addbtn" type="submit">Save</button>
        <a class="rm-cancel" href="/admin/improvements">Cancel</a>
      </form>
    ) : (
      <form class="rm-add" method="POST" action="/api/admin/roadmap">
        <input type="hidden" name="action" value="add" />
        <input
          class="tt-input"
          name="title"
          placeholder="Add a change to make…"
          maxlength="300"
          required
          autocomplete="off"
        />
        <label class="rm-datefield">
          <span>Raised</span>
          <input class="tt-input" type="date" name="entry_date" value={raisedToday} />
        </label>
        <button class="btn rm-addbtn" type="submit">Add</button>
      </form>
    )}

    <ol class={editing ? "rm-list is-editing" : "rm-list"}>
      {items.map((item, i) => (
        <li class={`rm-item${item.done ? " is-done" : ""}${editing === item.id ? " is-target" : ""}`}>
              {/* Each control is its own form. One form with several submit
                  buttons would work, but a stray Enter would then fire
                  whichever came first — here there is no ambiguity. */}
              <form method="POST" action="/api/admin/roadmap" class="rm-tick">
                <input type="hidden" name="action" value="toggle" />
                <input type="hidden" name="id" value={item.id} />
                {/* A button drawn as a checkbox, not a checkbox. A real one
                    needs a script to save on change, and would sit there
                    looking saved while having saved nothing. */}
                <button
                  type="submit"
                  class="rm-box"
                  aria-pressed={item.done ? "true" : "false"}
                  aria-label={item.done ? `Mark "${item.title}" as not done` : `Mark "${item.title}" as done`}
                >{item.done ? "✓" : ""}</button>
              </form>

              {/* The serial is the position in the list, so it renumbers when
                  things move. An id would be stable and meaningless here. */}
              <span class="rm-no">{i + 1}</span>

              <span class="rm-body">
                <span class="rm-title">{item.title}</span>
                {(item.entry_date || item.completion_date) && (
                  <span class="rm-dates">
                    {item.entry_date && <span>Raised {shown(item.entry_date)}</span>}
                    {item.entry_date && item.completion_date && <span class="rm-dot">·</span>}
                    {item.completion_date && <span>Completed {shown(item.completion_date)}</span>}
                  </span>
                )}
              </span>

              <span class="rm-moves">
                <form method="POST" action="/api/admin/roadmap">
                  <input type="hidden" name="action" value="up" />
                  <input type="hidden" name="id" value={item.id} />
                  <button type="submit" class="rm-move" disabled={i === 0} aria-label="Move up">▲</button>
                </form>
                <form method="POST" action="/api/admin/roadmap">
                  <input type="hidden" name="action" value="down" />
                  <input type="hidden" name="id" value={item.id} />
                  <button type="submit" class="rm-move" disabled={i === items.length - 1} aria-label="Move down">▼</button>
                </form>
              </span>

              <a class="rm-editlink" href={`/admin/improvements?edit=${item.id}`} aria-label={`Edit "${item.title}"`}>Edit</a>

              <form method="POST" action="/api/admin/roadmap">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={item.id} />
                <button type="submit" class="rm-del" aria-label={`Delete "${item.title}"`}>&times;</button>
              </form>
        </li>
      ))}
    </ol>

    <p class="note-foot">
      This list is only visible here. Ticking an item records that it is done and
      fills the completion date if it is empty; it does not change anything on
      the site.
    </p>
  </div>
</Base>
