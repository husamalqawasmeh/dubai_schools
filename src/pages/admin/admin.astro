---
import Base from "../../layouts/Base.astro";
import { env } from "cloudflare:workers";
import SignInPanel from "../../components/SignInPanel.astro";

const DB = (env as unknown as { DB: D1Database }).DB;
const admin = Astro.locals.admin!;

/* The box opens from a URL, not a script — the same way the roadmap board
   opens a row for editing. It costs a round trip and buys something that
   works with JavaScript off, survives a refresh, and can be linked to. */
const signin = Astro.url.searchParams.get("signin") !== null;

const pending = (
  await DB.prepare("SELECT COUNT(*) n FROM submissions WHERE status='pending'").first<{ n: number }>()
)?.n ?? 0;
---
<Base title="Admin — Dubai Schools">
  <div class="wrap adminwrap">
    <a class="back" href="/admin/overview">Overview</a>
    <div class="admin-bar">
      <div><h1>Admin</h1></div>
    </div>

    <div class="adminlinks">
      {/* First, and it opens the box below rather than linking out. Not to
          /admin/login: that redirects here the moment you are signed in,
          which you are if you can read this, so it would bounce straight
          back. Signing in again is how you switch account. */}
      <a class="adminlink is-alone" href={signin ? "/admin/admin" : "/admin/admin?signin"} aria-expanded={signin ? "true" : "false"}>
        <h2>Sign-in</h2>
      </a>
      {/* Directly under the option that opened it and one column wide, so it
          lines up with that card rather than with the page. */}
      {signin && (
        <SignInPanel
          class="adminsignin"
          heading="Sign in"
          blurb={`Signed in as ${admin.email}`}
        />
      )}
      <a class="adminlink is-newrow" href="/admin/account">
        <h2>Profile</h2>
      </a>
      <a class="adminlink" href="/admin/roadmap">
        <h2>Improvements and planned changes</h2>
      </a>
      <a class="adminlink" href="/admin/schools">
        <h2>Schools</h2>
      </a>
      <a class="adminlink" href="/admin/front-page">
        <h2>Front page testing</h2>
      </a>
      <a class="adminlink" href="/admin/moderation">
        <h2>Moderation queue</h2>
      </a>
      <a class="adminlink" href="/admin/pulse">
        <h2>Data from Dubai Pulse</h2>
      </a>
      <a class="adminlink" href="/admin/suppliers">
        <h2>Uniform suppliers</h2>
      </a>
      <a class="adminlink" href="/admin/settings">
        <h2>Hide offer options for now</h2>
      </a>
      {/* Both hide cards open the same settings screen, which now holds two
          toggles. The anchor drops you at the one the card names. */}
      <a class="adminlink" href="/admin/settings#supplies">
        <h2>Hide Supplies and Services Option</h2>
      </a>
      <form method="POST" action="/api/admin/logout" class="adminlink-form">
        <button class="adminlink" type="submit">
          <h2>Sign out</h2>
        </button>
      </form>
    </div>
  </div>
</Base>
