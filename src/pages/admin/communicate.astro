---
import Base from "../../layouts/Base.astro";

/**
 * The way in for whoever runs the site.
 *
 * This was the third tab on the Communicate page — /parents/communicate?as=site
 * — which put the console's front door inside a form meant for parents and
 * schools. It is not the same kind of thing as the other two tabs: they collect
 * something, this one lets a person in. So it has its own address.
 *
 * Deliberately on the middleware's open list, alongside /admin/login. Every
 * other page under /admin redirects an anonymous visitor to the login form,
 * which would make this page unreachable by exactly the person it is for.
 */
const admin = Astro.locals.admin;
---

<Base
  title="Site admin — Dubai Schools"
  description="Sign in to the Dubai Schools console."
>
  <div class="wrap contribute">
    <div class="contribute-head">
      <a class="back" href="/parents/communicate">Communicate</a>
      <h1>Site admin</h1>
    </div>

    <div class="tabpanel is-site">
      <div class="panel">
        {admin ? (
          <>
            <h2>Already signed in</h2>
            <p class="muted-p">
              Signed in as {admin.email}. The console has the moderation queue,
              the school data, the Dubai Pulse findings and the settings.
            </p>
            <a class="btn" href="/admin" style="max-width:200px">Open the console</a>
          </>
        ) : (
          <>
            <h2>Sign in</h2>
            <p class="muted-p">
              The console for moderating what comes in through the Communicate
              page, editing school data, and running the update against KHDA.
            </p>
            <a class="btn" href="/admin/login" style="max-width:200px">Sign in</a>
          </>
        )}
      </div>
    </div>
  </div>
</Base>
