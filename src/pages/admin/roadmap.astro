---
import Base from "../../layouts/Base.astro";
import { env } from "cloudflare:workers";

const DB = (env as unknown as { DB: D1Database }).DB;

const { results } = await DB.prepare(
  `SELECT id, title, done, position, entry_date, completion_date
     FROM roadmap ORDER BY position ASC, id ASC`
).all<{
  id: number;
  title: string;
  done: number;
  position: number;
  entry_date: string | null;
  completion_date: string | null;
}>();

const items = results ?? [];

/**
 * Which row is open for editing, from the query string.
 *
 * Editing is a URL rather than a script: ?edit=7 renders that one row as a
 * form. It costs a round trip and buys a board that works with JavaScript off,
 * survives a refresh mid-edit, and can be linked to.
 */
const editing = Number(Astro.url.searchParams.get("edit") ?? 0);

const shown = (d: string | null) =>
  d ? new Date(d + "T00:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : null;
---

<Base title="Improvements and planned changes — admin">
  <div class="wrap pick rm-page">
    <a class="back" href="/admin">&larr; Admin</a>
    <h1 style="margin-top:14px">Improvements and planned changes</h1>
    <form class="rm-add" method="POST" action="/api/admin/roadmap">
      <input type="hidden" name="action" value="add" />
      <input
        class="tt-input"
        name="title"
        placeholder="Add a change to make…"
        maxlength="300"
        required
        autocomplete="off"
      />
      <button class="btn rm-addbtn" type="submit">Add</button>
    </form>

    <ol class={editing ? "rm-list is-editing" : "rm-list"}>
      {items.map((item, i) => (
        <li class={item.done ? "rm-item is-done" : "rm-item"}>
          {editing === item.id ? (
            <form class="rm-edit" method="POST" action="/api/admin/roadmap">
              <input type="hidden" name="action" value="edit" />
              <input type="hidden" name="id" value={item.id} />
              <span class="rm-edit-row">
                <span class="rm-no">{i + 1}</span>
                <input class="tt-input rm-edit-title" name="title" value={item.title} maxlength="300" required />
              </span>
              <span class="rm-edit-row rm-edit-dates">
                <label class="rm-datefield">
                  <span>Raised</span>
                  <input class="tt-input" type="date" name="entry_date" value={item.entry_date ?? ""} />
                </label>
                <label class="rm-datefield">
                  <span>Completed</span>
                  <input class="tt-input" type="date" name="completion_date" value={item.completion_date ?? ""} />
                </label>
              </span>
              <span class="rm-edit-row rm-edit-actions">
                <button class="btn rm-save" type="submit">Save</button>
                <a class="rm-cancel" href="/admin/roadmap">Cancel</a>
              </span>
            </form>
          ) : (
            <>
              {/* Each control is its own form. One form with several submit
                  buttons would work, but a stray Enter would then fire
                  whichever came first — here there is no ambiguity. */}
              <form method="POST" action="/api/admin/roadmap" class="rm-tick">
                <input type="hidden" name="action" value="toggle" />
                <input type="hidden" name="id" value={item.id} />
                {/* A button drawn as a checkbox, not a checkbox. A real one
                    needs a script to save on change, and would sit there
                    looking saved while having saved nothing. */}
                <button
                  type="submit"
                  class="rm-box"
                  aria-pressed={item.done ? "true" : "false"}
                  aria-label={item.done ? `Mark "${item.title}" as not done` : `Mark "${item.title}" as done`}
                >{item.done ? "✓" : ""}</button>
              </form>

              {/* The serial is the position in the list, so it renumbers when
                  things move. An id would be stable and meaningless here. */}
              <span class="rm-no">{i + 1}</span>

              <span class="rm-body">
                <span class="rm-title">{item.title}</span>
                {(item.entry_date || item.completion_date) && (
                  <span class="rm-dates">
                    {item.entry_date && <span>Raised {shown(item.entry_date)}</span>}
                    {item.entry_date && item.completion_date && <span class="rm-dot">·</span>}
                    {item.completion_date && <span>Completed {shown(item.completion_date)}</span>}
                  </span>
                )}
              </span>

              <span class="rm-moves">
                <form method="POST" action="/api/admin/roadmap">
                  <input type="hidden" name="action" value="up" />
                  <input type="hidden" name="id" value={item.id} />
                  <button type="submit" class="rm-move" disabled={i === 0} aria-label="Move up">▲</button>
                </form>
                <form method="POST" action="/api/admin/roadmap">
                  <input type="hidden" name="action" value="down" />
                  <input type="hidden" name="id" value={item.id} />
                  <button type="submit" class="rm-move" disabled={i === items.length - 1} aria-label="Move down">▼</button>
                </form>
              </span>

              <a class="rm-editlink" href={`/admin/roadmap?edit=${item.id}`} aria-label={`Edit "${item.title}"`}>Edit</a>

              <form method="POST" action="/api/admin/roadmap">
                <input type="hidden" name="action" value="delete" />
                <input type="hidden" name="id" value={item.id} />
                <button type="submit" class="rm-del" aria-label={`Delete "${item.title}"`}>&times;</button>
              </form>
            </>
          )}
        </li>
      ))}
    </ol>

    <p class="note-foot">
      This list is only visible here. Ticking an item records that it is done and
      fills the completion date if it is empty; it does not change anything on
      the site.
    </p>
  </div>
</Base>
