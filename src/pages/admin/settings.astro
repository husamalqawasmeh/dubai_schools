---
import Base from "../../layouts/Base.astro";
import { HIDE_PAID_TIERS, getFlag, settingMeta } from "../../lib/settings";

const hidePaid = await getFlag(HIDE_PAID_TIERS);
const meta = await settingMeta(HIDE_PAID_TIERS);
const lastSet =
  meta?.updated_at
    ? new Date(meta.updated_at).toLocaleDateString("en-GB", {
        day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
      }) + (meta.email ? ` by ${meta.email}` : "")
    : null;
---
<Base title="Settings — Dubai Schools admin">
  <div class="wrap adminwrap">
    <div class="admin-bar">
      <div><h1>Settings</h1></div>
      <a class="btn sec" href="/admin" style="margin:0;padding:6px 12px">Back to admin</a>
    </div>

    <div class="panel" style="max-width:38rem">
      <label class="setting">
        <input type="checkbox" id="hidePaidTiers" checked={hidePaid} />
        <span>
          <b>Hide the paid packages on the advertising page</b>
          <span class="setting-note">
            Enhanced (AED 2,400) and Featured (AED 7,200) come off
            <a href="/advertise">/advertise</a> while this is on. The free
            Verified tier stays: claiming a listing costs nothing, and that is
            what the page is for. Nothing else on the site changes.
          </span>
        </span>
      </label>

      <label class="setting" id="supplies">
        <input type="checkbox" id="hideSupplies" checked={hideSupplies} />
        <span>
          <b>Hide School Supplies in the navigation</b>
          <span class="setting-note">
            The <a href="/supplies">School Supplies</a> item comes out of the
            menu while this is on. The page itself stays reachable by its
            address — hiding a link is not deleting a page, and anything
            already pointing at it should not start 404ing because a menu
            item was switched off.
          </span>
        </span>
      </label>

      <p class="note" id="msg">
        {lastSet ? `Last changed ${lastSet}.` : "Not changed yet."}
      </p>
    </div>
  </div>
</Base>

<script>
  /* One handler, both boxes. The flag name is on the element, so adding a
     third toggle is a checkbox and a FLAGS entry — not another copy of
     this. */
  const msg = document.getElementById("msg")!;
  const SAID: Record<string, [string, string]> = {
    hidePaidTiers: ["Saved. The paid packages are hidden.", "Saved. The paid packages are showing."],
    hideSupplies: ["Saved. School Supplies is out of the menu.", "Saved. School Supplies is back in the menu."],
  };

  for (const id of Object.keys(SAID)) {
    const box = document.getElementById(id) as HTMLInputElement | null;
    if (!box) continue;

    box.addEventListener("change", async () => {
      box.disabled = true;
      msg.textContent = "Saving…";
      msg.className = "note";

      try {
        const res = await fetch("/api/admin/settings", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ [id]: box.checked }),
        });
        const out = (await res.json()) as { ok: boolean; error?: string };
        if (!out.ok) throw new Error(out.error ?? "Could not save that.");
        msg.textContent = SAID[id][box.checked ? 0 : 1];
      } catch (err) {
        // Put the box back to what the server still believes, or the screen
        // shows a setting that was never saved.
        box.checked = !box.checked;
        msg.textContent = err instanceof Error ? err.message : "Could not save that.";
        msg.className = "note is-bad";
      } finally {
        box.disabled = false;
      }
    });
  }
</script>
