---
import Base from "../../layouts/Base.astro";
import { env } from "cloudflare:workers";

const DB = (env as unknown as { DB: D1Database }).DB;
const admin = Astro.locals.admin!;

const pending = (
  await DB.prepare("SELECT COUNT(*) n FROM submissions WHERE status='pending'").first<{ n: number }>()
)?.n ?? 0;
---
<Base title="Admin — Dubai Schools">
  <div class="wrap adminwrap">
    <a class="back" href="/parents/communicate">Communicate</a>
    <div class="admin-bar">
      <div><h1>Admin</h1></div>
    </div>

    <div class="adminlinks">
      {/* First, and pointing at the site-admin door rather than at
          /admin/login — the login form redirects here the moment you
          are signed in, which you are if you can read this, so it
          would bounce straight back. That page says which account is
          signed in and offers the switch. */}
      <a class="adminlink" href="/admin/communicate">
        <h2>Sign-in</h2>
      </a>
      <a class="adminlink" href="/admin/account">
        <h2>Profile</h2>
      </a>
      <a class="adminlink" href="/admin/roadmap">
        <h2>Improvements and planned changes</h2>
      </a>
      <a class="adminlink" href="/admin/schools">
        <h2>Schools</h2>
      </a>
      <a class="adminlink" href="/admin/front-page">
        <h2>Front page testing</h2>
      </a>
      <a class="adminlink" href="/admin/moderation">
        <h2>Moderation queue</h2>
      </a>
      <a class="adminlink" href="/admin/pulse">
        <h2>Data from Dubai Pulse</h2>
      </a>
      <a class="adminlink" href="/admin/suppliers">
        <h2>Uniform suppliers</h2>
      </a>
      <a class="adminlink" href="/admin/settings">
        <h2>Hide offer options for now</h2>
      </a>
      {/* Both hide cards open the same settings screen, which now holds two
          toggles. The anchor drops you at the one the card names. */}
      <a class="adminlink" href="/admin/settings#supplies">
        <h2>Hide Supplies and Services Option</h2>
      </a>
      <form method="POST" action="/api/admin/logout" class="adminlink-form">
        <button class="adminlink" type="submit">
          <h2>Sign out</h2>
        </button>
      </form>
    </div>
  </div>
</Base>
