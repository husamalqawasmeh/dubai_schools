{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dubai-schools",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Keep the workers.dev URL alive: defining `routes` turns it off by default,
  // which would leave the Worker unreachable until the custom domain exists.
  "workers_dev": true,
  "routes": [
    { "pattern": "dubai-schools.can-du-ai.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dubai-schools",
      "database_id": "5f8286f1-bf48-4760-a941-3995e8caccc6"
    }
  ]
}
