/**
 * Loads src/data/school-emails.json into schools.khda_email.
 *   node scripts/seed-emails.mts [--local]
 * Only institutional addresses are written; free-mail ones are skipped.
 */
import { readFile, writeFile, unlink } from "node:fs/promises";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";
import { spawnSync } from "node:child_process";

const REPO = join(dirname(fileURLToPath(import.meta.url)), "..");
const LOCAL = process.argv.includes("--local");
const OUT = join(REPO, ".emails.sql");

const rows = JSON.parse(await readFile(join(REPO, "src", "data", "school-emails.json"), "utf8"));
const schools = JSON.parse(await readFile(join(REPO, "src", "data", "schools.json"), "utf8"));
const byName = new Map<string, string>();
for (const s of schools) byName.set(s.name.trim().toLowerCase(), s.khdaId);

const q = (v: string) => `'${v.replace(/'/g, "''")}'`;
const lines = ["-- generated by scripts/seed-emails.mts", "UPDATE schools SET khda_email = NULL;"];
let written = 0, unmatched = 0;

for (const r of rows) {
  if (!r.institutional) continue;
  const khdaId = byName.get((r.schoolName ?? "").trim().toLowerCase());
  if (!khdaId) { unmatched++; continue; }
  lines.push(`UPDATE schools SET khda_email = ${q(r.email)} WHERE khda_id = ${q(khdaId)};`);
  written++;
}

await writeFile(OUT, lines.join("\n"), "utf8");
console.log(`  ${written} institutional addresses queued, ${unmatched} unmatched by name`);
const res = spawnSync("npx", ["wrangler", "d1", "execute", "dubai-schools", LOCAL ? "--local" : "--remote", `--file=${OUT}`], { stdio: "pipe", shell: true, encoding: "utf8" });
try { await unlink(OUT); } catch {}
if (res.status !== 0) { console.error(res.stderr || res.stdout); process.exit(1); }
console.log("  applied");
